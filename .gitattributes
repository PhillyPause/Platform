# Normalize line endings in the repository; check out as-is per platform default.
* text=auto

# Always LF: files consumed by Linux containers or tooling that cares.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Never touch binary assets.
*.png binary
*.ico binary
*.woff2 binary

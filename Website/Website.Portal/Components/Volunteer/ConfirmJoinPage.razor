@page "/volunteer/confirm/{Token}"
@inject AuthTokenRepository Tokens
@inject AdminBootstrap Admins
@inject VolunteerRepository Volunteers

@* Where the link in a joining email lands. Like sign-in, opening it does
   nothing and the button does, because mail scanners open every link in a
   message. Pressing it confirms the address and signs the person in: it
   proves they read mail there, as a sign-in link does. *@

<PageMeta Title="Finish joining" Description="Confirm your address to finish joining PhillyPause." NoIndex="true" />

<div class="wrap page-head">
    @if (_welcomed is not null)
    {
        <h1>You are in, @_welcomed</h1>
        <p class="lead">From now on you will hear from us when something matches what you ticked. Nothing else.</p>
    }
    else if (_spent)
    {
        <h1>This link has done its job</h1>
    }
    else
    {
        <h1>One click and you are in</h1>
        <p class="lead">This tells us the address is yours, and signs you in on this device.</p>
    }
</div>

<div class="wrap vol-body">
    <section class="vol-card vol-narrow">
        @if (_welcomed is not null)
        {
            <p>
                See <a href="@ManyHandsPaths.Events" data-enhance-nav="false">what is coming up</a>, or open
                <a href="@ManyHandsPaths.Me">your page</a> to change what you like doing.
                Every email has a one-click way out.
            </p>
        }
        else if (_spent)
        {
            <p>
                It has been used already, or it is more than a month old. If you have
                clicked one of these before, you are all set and there is nothing more to do.
                You can <a href="@ManyHandsPaths.SignIn">sign in</a> any time, which confirms
                your address too.
            </p>
        }
        else
        {
            <EditForm Model="Input" FormName="confirm" OnSubmit="ConfirmAsync" class="vol-form">
                <button class="btn" type="submit">Yes, that is me</button>
            </EditForm>
        }
    </section>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // The button carries nothing; the token is in the address.
    [SupplyParameterFromForm(FormName = "confirm")] private ConfirmInput? Input { get; set; }

    private string? _welcomed;
    private bool _spent;

    protected override void OnInitialized()
    {
        Input ??= new();

        // The token is in this page's address; nothing it links to needs to see it.
        HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";
    }

    private async Task ConfirmAsync()
    {
        if (await Tokens.ConfirmAsync(Token) is MagicLinkResult.Ok ok)
        {
            await Admins.ApplyAsync(ok.VolunteerId);

            // Read after the bootstrap, so a new admin's first cookie says so.
            if (await Volunteers.GetByIdAsync(ok.VolunteerId) is { IsDeleted: false } volunteer)
            {
                await VolunteerSession.SignInAsync(HttpContext, volunteer);
                _welcomed = volunteer.DisplayName;
                return;
            }
        }

        _spent = true;
    }

    private sealed class ConfirmInput;
}

@page "/volunteer/outreach"
@attribute [Authorize]
@inject OutreachRepository Outreach
@inject Website.Content.OfficialsStore Officials

@* A volunteer's own record of contacting officials from the action centre:
   how much, whom, and who they have not reached yet among the people they
   have already started on. Only what happened; never what was said. *@

<PageMeta Title="My outreach" Description="The officials you have called and written to, and how it went." NoIndex="true" />

<div class="wrap page-head">
    <h1>Your outreach</h1>
    <p class="lead">Every call and message you have told us about. Offices count constituents; this is your count.</p>
</div>

<div class="wrap vol-body vol-stack">
    <section aria-labelledby="totals-head" class="vol-card">
        <h2 id="totals-head">So far</h2>
        @if (_actions.Count == 0)
        {
            <p>Nothing yet. <a href="/act">Find who represents you</a>: a call takes five minutes.</p>
        }
        else
        {
            <ul class="vol-figures">
                <li><strong>@_actions.Count</strong> <span>@(_actions.Count == 1 ? "action" : "actions")</span></li>
                <li><strong>@_actions.Count(a => a.Channel == OutreachChannel.Call)</strong> <span>calls</span></li>
                <li><strong>@_actions.Count(a => a.Channel != OutreachChannel.Call)</strong> <span>messages</span></li>
                <li><strong>@_actions.Select(a => a.OfficialKey).Distinct().Count()</strong> <span>officials</span></li>
            </ul>
            <p><a class="btn" href="/act">Take another action</a></p>
        }
    </section>

    @if (_actions.Count > 0)
    {
        <section aria-labelledby="log-head">
            <h2 id="log-head">What you have done</h2>
            <table class="vol-table">
                <thead>
                    <tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">How</th><th scope="col">Notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var action in _actions)
                    {
                        <tr>
                            <td>@LocalTime.FormatShort(action.OccurredAt)</td>
                            <td>
                                @if (Officials.Find(action.OfficialKey) is { } official)
                                {
                                    <a href="/act/officials/@official.Key">@action.OfficialName</a>
                                }
                                else
                                {
                                    @action.OfficialName
                                }
                            </td>
                            <td>
                                @action.Channel.Label()
                                @if (action.Channel == OutreachChannel.Call && action.Outcome is { } outcome)
                                {
                                    <div class="vol-small">@outcome.Label()</div>
                                }
                            </td>
                            <td class="vol-small">@action.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (_followUps.Count > 0)
        {
            <section aria-labelledby="next-head">
                <h2 id="next-head">Worth a follow-up</h2>
                <p>You wrote to these offices a while ago. A short call asking whether they received it, and for a reply, is often what gets one.</p>
                <ul class="vol-people">
                    @foreach (var official in _followUps)
                    {
                        <li><a href="/act/call/@official.Key">Call @official.Name</a></li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private IReadOnlyList<OutreachAction> _actions = [];
    private IReadOnlyList<Website.Content.Official> _followUps = [];

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.VolunteerId() is not Guid me) return;

        _actions = await Outreach.ForVolunteerAsync(me);

        // Written to more than two weeks ago and not called since: the follow-up
        // call is the cheapest way to get an answer.
        var cutoff = DateTimeOffset.UtcNow.AddDays(-14);
        _followUps = _actions
            .GroupBy(a => a.OfficialKey)
            .Where(g => g.Any(a => a.Channel != OutreachChannel.Call && a.OccurredAt < cutoff)
                        && !g.Any(a => a.Channel == OutreachChannel.Call && a.OccurredAt >= g.Where(x => x.Channel != OutreachChannel.Call).Max(x => x.OccurredAt)))
            .Select(g => Officials.Find(g.Key))
            .OfType<Website.Content.Official>()
            .Where(o => o.Phones.Count > 0)
            .Take(5)
            .ToArray();
    }
}

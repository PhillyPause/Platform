@page "/volunteer/remove/{CommsKey:guid}"
@inject VolunteerDataRepository Data

@* "Not you, or changed your mind?" from a joining email. It asks before it
   acts, as unsubscribing does, because mail scanners open links. Removing
   is the same deletion as the button on someone's own page. *@

<PageMeta Title="Remove me" Description="Take your details off PhillyPause's list." NoIndex="true" />

<div class="wrap page-head">
    <h1>
        @(_result switch
        {
            RemoveResult.Organizer => "You organize with us",
            not null => "Done: you are off our list",
            _ => "Take your details off our list?",
        })
    </h1>
</div>

<div class="wrap vol-body">
    <section class="vol-card vol-narrow">
        @if (_result is RemoveResult.Organizer)
        {
            <p>
                So this link cannot remove you; organizers leave from
                <a href="@ManyHandsPaths.Me">their own page</a>, where the delete button is.
            </p>
        }
        else if (_result is not null)
        {
            <p>
                Your name, email and interests are gone, and we will not write again.
                If someone else put your address in, we are sorry for the bother.
                You are welcome back any time.
            </p>
        }
        else
        {
            <p>
                This deletes your name, email and what you said you like doing. If you
                signed up for something, it still counts that someone came, without you
                attached. There is nothing else to do and no one will ask why.
            </p>
            <EditForm Model="Input" FormName="remove" OnSubmit="RemoveAsync" class="vol-form">
                <button class="btn" type="submit">Remove me</button>
            </EditForm>
        }
    </section>
</div>

@code {
    [Parameter] public Guid CommsKey { get; set; }

    [SupplyParameterFromForm(FormName = "remove")] private RemoveInput? Input { get; set; }

    private RemoveResult? _result;

    protected override void OnInitialized() => Input ??= new();

    // An unknown key reads as done: this page must not tell a stranger whether
    // an address is real.
    private async Task RemoveAsync() => _result = await Data.RemoveByCommsKeyAsync(CommsKey);

    private sealed class RemoveInput;
}

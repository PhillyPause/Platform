@page "/{*Slug}"
@inject ContentStore Content
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@using ManyHands.Data

@* Every Markdown page routes through here. Static server rendering — no
   interactivity, so no WebAssembly download (PLAN.md 2.1). *@

@if (_page is not null)
{
    <PageMeta Title="@_page.Title" Description="@_page.Description" />

    <div class="wrap page-head">
        <h1>@_page.Title</h1>
        <p class="lead">@_page.Description</p>
    </div>

    <div class="wrap" style="padding-bottom: 4rem">
        <article class="prose">
            @((MarkupString)Content.HtmlFor(_page, Configuration.IsManyHandsEnabled()))
        </article>
        <SourceCredit Page="_page" />
    </div>
}

@code {
    /// <summary>Null during WebAssembly rendering; present for the prerender.</summary>
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Parameter] public string? Slug { get; set; }

    private ContentPage? _page;

    protected override void OnParametersSet()
    {
        _page = Content.Find(Slug);

        // A real 404, not a 200 with a "not found" body (a soft 404, which
        // search engines index as a page), rendered by NotFound.razor: the
        // front page with its Not found dialog, like every other 404.
        if (_page is null && HttpContext is not null)
            Navigation.NotFound();
    }
}

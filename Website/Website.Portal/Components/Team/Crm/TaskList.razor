@inject CrmRepository Crm

@* A list of CRM tasks with a Done button each. Its own form, so any page can
   show tasks without wiring the buttons itself; one per page. *@

<EditForm Model="Done" FormName="task-done" OnSubmit="CompleteAsync">
    <ul class="mh-list mh-tasks">
        @foreach (var task in Tasks.Where(t => !_completed.Contains(t.Id)))
        {
            var late = task.IsOverdueOn(_today);
            <li>
                <div class="mh-list-main">
                    <strong>@task.Title</strong>
                    @if (late) { <span class="mh-badge mh-badge-danger">Overdue</span> }
                    <div class="mh-meta">
                        <span>@(task.DueOn is { } due ? $"due {due:MMM d}" : "no date")</span>
                        @if (task.AssignedToName is { } who) { <span>@who</span> }
                        @if (task.OrganizationId is { } org) { <span><a href="@ManyHandsPaths.CrmOrganization(org)">@task.OrganizationName</a></span> }
                        @if (task.EngagementId is { } eng) { <span><a href="@ManyHandsPaths.CrmEngagement(eng)">@task.EngagementTitle</a></span> }
                    </div>
                </div>
                <div class="mh-list-end">
                    <button class="mh-btn mh-btn-secondary mh-btn-small" type="submit" name="Done.TaskId" value="@task.Id"
                            aria-label="@($"Done: {task.Title}")">Done</button>
                </div>
            </li>
        }
    </ul>
</EditForm>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<CrmTaskSummary> Tasks { get; set; }

    [SupplyParameterFromForm(FormName = "task-done")] private DoneInput? Done { get; set; }

    private readonly HashSet<Guid> _completed = [];
    private DateOnly _today;

    protected override void OnInitialized()
    {
        Done ??= new();
        _today = DateOnly.FromDateTime(LocalTime.ToLocal(DateTimeOffset.UtcNow));
    }

    private async Task CompleteAsync()
    {
        if (Done!.TaskId is Guid id && await Crm.SetTaskStatusAsync(id, CrmTaskStatus.Done))
            _completed.Add(id);
    }

    private sealed class DoneInput
    {
        public Guid? TaskId { get; set; }
    }
}

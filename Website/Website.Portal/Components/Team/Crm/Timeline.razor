@* What has happened with an organization, contact or engagement, newest first. *@

@if (Entries.Count == 0)
{
    <div class="mh-empty">
        <p class="mh-empty-title">Nothing logged yet</p>
        <p>After a call, a meeting or an email, say what happened above, so whoever picks this up next knows.</p>
    </div>
}
else
{
    <ol class="mh-timeline">
        @foreach (var entry in Entries)
        {
            <li>
                <div class="mh-meta">
                    <span><strong>@Show.Words(entry.Kind)</strong></span>
                    <span>@Show.Stamp(entry.OccurredAt)</span>
                    @if (entry.ContactName is { } who) { <span>@who</span> }
                    @if (entry.EngagementTitle is { } what) { <span>@what</span> }
                    @if (entry.LoggedByName is { } by) { <span>by @by</span> }
                </div>
                @foreach (var paragraph in Show.Paragraphs(entry.Body))
                {
                    <p>@paragraph</p>
                }
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<TimelineEntry> Entries { get; set; }
}

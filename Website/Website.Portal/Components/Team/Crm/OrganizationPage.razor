@page "/team/crm/organization/{Id:guid}"
@inject CrmRepository Crm
@inject CrmEmailRepository Emails
@inject NavigationManager Navigation

<PageMeta Title="@(_org?.Name ?? "Organization")" Description="An organization in the CRM." NoIndex="true" />

@if (_org is null)
{
    return;
}

<header class="mh-page-head">
    <div>
        <p class="mh-crumb"><a href="@ManyHandsPaths.Crm">Organizations</a></p>
        <div class="mh-title-row">
            <h1>@_org.Name</h1>
            <span class="mh-badge">@Show.Words(_org.Kind)</span>
        </div>
        <p class="mh-meta">
            @if (_org.State is { } state) { <span>@state@(_org.District is { } d ? $"-{d}" : "")</span> }
            @if (Show.SafeLink(_org.Website) is { } site) { <span><a href="@site" target="_blank" rel="noopener">Website</a></span> }
            <span>@_contacts.Count @(_contacts.Count == 1 ? "person" : "people")</span>
            <span>@_tasks.Count still to do</span>
        </p>
    </div>
</header>

@if (_notice is not null)
{
    <p class="mh-notice" role="status">@_notice</p>
}

<div class="mh-columns">
    <div class="mh-stack">
        <section class="mh-panel" aria-labelledby="people-head">
            <h2 id="people-head">People</h2>
            @if (_contacts.Count == 0)
            {
                <p class="mh-small">Nobody yet. Add the person you deal with there, so mail to and from them files itself here.</p>
            }
            else
            {
                <EditForm Model="RemoveContact" FormName="contact-remove" OnSubmit="RemoveContactAsync">
                    <ul class="mh-list">
                        @foreach (var contact in _contacts)
                        {
                            <li>
                                <div class="mh-list-main">
                                    <strong>@contact.FullName</strong>@(contact.RoleTitle is { } role ? $", {role}" : "")
                                    <div class="mh-meta">
                                        @if (contact.Email is { } email) { <span><a href="@($"{ManyHandsPaths.InboxCompose}?contact={contact.Id}")">@email</a></span> }
                                        @if (contact.Phone is { } phone) { <span>@phone</span> }
                                    </div>
                                </div>
                                <div class="mh-list-end">
                                    <button class="mh-btn mh-btn-quiet" type="submit" name="RemoveContact.Id" value="@contact.Id"
                                            aria-label="@($"Remove {contact.FullName}")">Remove</button>
                                </div>
                            </li>
                        }
                    </ul>
                </EditForm>
            }
            <div class="mh-panel-foot">
                <EditForm Model="NewContact" FormName="contact" OnValidSubmit="AddContactAsync" class="mh-form mh-inline-form">
                    <DataAnnotationsValidator />
                    <label class="mh-field"><span class="mh-label">Name</span><InputText @bind-Value="NewContact!.FullName" /></label>
                    <label class="mh-field"><span class="mh-label">Role</span><InputText @bind-Value="NewContact!.RoleTitle" placeholder="Chief of staff" /></label>
                    <label class="mh-field"><span class="mh-label">Email</span><InputText @bind-Value="NewContact!.Email" type="email" /></label>
                    <label class="mh-field"><span class="mh-label">Phone</span><InputText @bind-Value="NewContact!.Phone" /></label>
                    <ValidationMessage For="() => NewContact!.FullName" />
                    <button class="mh-btn mh-btn-secondary" type="submit">Add a person</button>
                </EditForm>
            </div>
        </section>

        <section class="mh-panel" aria-labelledby="work-head">
            <h2 id="work-head">Engagements</h2>
            @if (_engagements.Count == 0)
            {
                <p class="mh-small">No effort with them yet. Start one for a meeting, a letter or an ask, and follow it on the Pipeline.</p>
            }
            else
            {
                <ul class="mh-list">
                    @foreach (var engagement in _engagements)
                    {
                        <li>
                            <div class="mh-list-main">
                                <a href="@ManyHandsPaths.CrmEngagement(engagement.Id)">@engagement.Title</a>
                                @if (engagement.ScheduledAt is { } at) { <div class="mh-meta"><span>@Show.Stamp(at)</span></div> }
                            </div>
                            <div class="mh-list-end"><span class="mh-badge mh-badge-info">@Show.Words(engagement.Status)</span></div>
                        </li>
                    }
                </ul>
            }
            <div class="mh-panel-foot">
                <EditForm Model="NewEngagement" FormName="engagement" OnValidSubmit="AddEngagementAsync" class="mh-form mh-inline-form">
                    <DataAnnotationsValidator />
                    <label class="mh-field mh-field-wide"><span class="mh-label">A new effort with them</span><InputText @bind-Value="NewEngagement!.Title" placeholder="Meeting about the AI bill" /></label>
                    <ValidationMessage For="() => NewEngagement!.Title" />
                    <button class="mh-btn mh-btn-secondary" type="submit">Start it</button>
                </EditForm>
            </div>
        </section>

        <section class="mh-panel" aria-labelledby="todo-head">
            <h2 id="todo-head">Still to do</h2>
            @if (_tasks.Count == 0)
            {
                <p class="mh-small">Nothing open for them. Add what needs doing next, with a day if it has one.</p>
            }
            @* Always there, empty or not: its Done buttons post to it. *@
            <TaskList Tasks="_tasks" />
            <div class="mh-panel-foot">
                <EditForm Model="NewTask" FormName="task" OnValidSubmit="AddTaskAsync" class="mh-form mh-inline-form">
                    <DataAnnotationsValidator />
                    <label class="mh-field mh-field-wide"><span class="mh-label">Task</span><InputText @bind-Value="NewTask!.Title" placeholder="Send the follow-up letter" /></label>
                    <label class="mh-field"><span class="mh-label">By</span><InputDate @bind-Value="NewTask!.DueOn" /></label>
                    <ValidationMessage For="() => NewTask!.Title" />
                    <button class="mh-btn mh-btn-secondary" type="submit">Add</button>
                </EditForm>
            </div>
        </section>

        <section class="mh-panel" aria-labelledby="timeline-head">
            <h2 id="timeline-head">What has happened</h2>
            <LogInteraction OrganizationId="Id" OnLogged="ReloadAsync" />
            <Timeline Entries="_timeline" />
            @if (_emails.Count > 0)
            {
                <div class="mh-panel-sub">
                    <h3>Mail</h3>
                    <ul class="mh-list">
                        @foreach (var email in _emails)
                        {
                            <li>
                                <div class="mh-list-main">
                                    <a href="@ManyHandsPaths.InboxThread(email.ConversationId)">@email.Subject</a>
                                    <div class="mh-meta">
                                        <span>@(email.Direction == EmailDirection.Inbound ? "from" : "to") @(email.Direction == EmailDirection.Inbound ? email.FromAddress : email.ToAddress)</span>
                                        <span>@Show.Stamp(email.OccurredAt)</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    </div>

    <aside class="mh-stack" aria-label="About them">
        <section class="mh-panel" aria-labelledby="details-head">
            <h2 id="details-head">Details</h2>
            <EditForm Model="Details" FormName="details" OnValidSubmit="SaveDetailsAsync" class="mh-form">
                <DataAnnotationsValidator />
                <label class="mh-field"><span class="mh-label">Name</span><InputText @bind-Value="Details!.Name" /><ValidationMessage For="() => Details!.Name" /></label>
                <label class="mh-field">
                    <span class="mh-label">Kind</span>
                    <InputSelect @bind-Value="Details!.Kind">
                        @foreach (var kind in Enum.GetValues<OrganizationKind>()) { <option value="@kind">@Show.Words(kind)</option> }
                    </InputSelect>
                </label>
                <label class="mh-field"><span class="mh-label">About them</span><InputTextArea @bind-Value="Details!.Description" rows="3" /></label>
                <label class="mh-field"><span class="mh-label">Website</span><InputText @bind-Value="Details!.Website" type="url" /></label>
                <label class="mh-field"><span class="mh-label">Address</span><InputText @bind-Value="Details!.Address" /></label>
                <div class="mh-pair">
                    <label class="mh-field"><span class="mh-label">State</span><InputText @bind-Value="Details!.State" maxlength="2" /><ValidationMessage For="() => Details!.State" /></label>
                    <label class="mh-field"><span class="mh-label">District</span><InputText @bind-Value="Details!.District" /></label>
                </div>
                <div class="mh-form-actions">
                    <button class="mh-btn mh-btn-primary" type="submit">Save</button>
                </div>
            </EditForm>
        </section>

        <section class="mh-danger-zone" aria-labelledby="remove-head">
            <h3 id="remove-head">No longer working with them?</h3>
            <p class="mh-small">It is hidden, not destroyed: its history stays.</p>
            <EditForm Model="Remove" FormName="remove" OnSubmit="RemoveAsync">
                <button class="mh-btn mh-btn-danger" type="submit">Remove this organization</button>
            </EditForm>
        </section>
    </aside>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "contact")] private ContactInput? NewContact { get; set; }
    [SupplyParameterFromForm(FormName = "contact-remove")] private IdInput? RemoveContact { get; set; }
    [SupplyParameterFromForm(FormName = "engagement")] private TitleInput? NewEngagement { get; set; }
    [SupplyParameterFromForm(FormName = "task")] private TaskInput? NewTask { get; set; }
    [SupplyParameterFromForm(FormName = "details")] private DetailsInput? Details { get; set; }
    [SupplyParameterFromForm(FormName = "remove")] private IdInput? Remove { get; set; }

    private CrmOrganization? _org;
    private IReadOnlyList<CrmContact> _contacts = [];
    private IReadOnlyList<EngagementSummary> _engagements = [];
    private IReadOnlyList<CrmTaskSummary> _tasks = [];
    private IReadOnlyList<TimelineEntry> _timeline = [];
    private IReadOnlyList<CrmEmail> _emails = [];
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        NewContact ??= new();
        RemoveContact ??= new();
        NewEngagement ??= new();
        NewTask ??= new();
        Remove ??= new();

        _org = await Crm.GetOrganizationAsync(Id);
        if (_org is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        Details ??= DetailsInput.From(_org);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _org = await Crm.GetOrganizationAsync(Id);
        _contacts = await Crm.GetContactsAsync(Id);
        _engagements = await Crm.GetEngagementsAsync(Id);
        _tasks = await Crm.GetTasksAsync(CrmTaskStatus.Open, organizationId: Id);
        _timeline = await Crm.GetTimelineAsync(organizationId: Id);
        _emails = await Emails.GetForOrganizationAsync(Id);
    }

    private async Task AddContactAsync()
    {
        await Crm.SaveContactAsync(null, Id, NewContact!.FullName.Trim(), Blank(NewContact.RoleTitle),
            Blank(NewContact.Email), Blank(NewContact.Phone), null);
        _notice = $"{NewContact.FullName.Trim()} added.";
        NewContact = new();
        await ReloadAsync();
    }

    private async Task RemoveContactAsync()
    {
        if (RemoveContact!.Id is Guid id) await Crm.DeleteContactAsync(id);
        await ReloadAsync();
    }

    private async Task AddEngagementAsync()
    {
        var id = await Crm.SaveEngagementAsync(null, new EngagementFields(
            Id, NewEngagement!.Title.Trim(), EngagementStatus.Draft, null,
            HttpContext.User.VolunteerId(), null, null, null, null));
        Navigation.NavigateTo(ManyHandsPaths.CrmEngagement(id));
    }

    private async Task AddTaskAsync()
    {
        await Crm.AddTaskAsync(NewTask!.Title.Trim(), null, Id, NewTask.DueOn, HttpContext.User.VolunteerId());
        NewTask = new();
        await ReloadAsync();
    }

    private async Task SaveDetailsAsync()
    {
        await Crm.UpdateOrganizationAsync(Id, new OrganizationFields(
            Details!.Kind, Details.Name.Trim(), Blank(Details.Description), Blank(Details.Website),
            Blank(Details.Address), Blank(Details.State)?.ToUpperInvariant(), Blank(Details.District)));
        _notice = "Saved.";
        await ReloadAsync();
    }

    private async Task RemoveAsync()
    {
        await Crm.DeleteOrganizationAsync(Id);
        Navigation.NavigateTo(ManyHandsPaths.Crm);
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class IdInput
    {
        public Guid? Id { get; set; }
    }

    private sealed class TitleInput
    {
        [Required(ErrorMessage = "Give it a name.")]
        [StringLength(200)]
        public string Title { get; set; } = string.Empty;
    }

    private sealed class TaskInput
    {
        [Required(ErrorMessage = "Say what needs doing.")]
        [StringLength(300)]
        public string Title { get; set; } = string.Empty;

        public DateOnly? DueOn { get; set; }
    }

    private sealed class ContactInput
    {
        [Required(ErrorMessage = "A name, at least.")]
        [StringLength(200)]
        public string FullName { get; set; } = string.Empty;

        [StringLength(200)] public string? RoleTitle { get; set; }
        [StringLength(254)] public string? Email { get; set; }
        [StringLength(50)] public string? Phone { get; set; }
    }

    private sealed class DetailsInput
    {
        [Required(ErrorMessage = "It needs a name.")]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        public OrganizationKind Kind { get; set; }
        [StringLength(2000)] public string? Description { get; set; }
        [StringLength(500)] public string? Website { get; set; }
        [StringLength(500)] public string? Address { get; set; }

        [RegularExpression("^[A-Za-z]{2}$", ErrorMessage = "Two letters, like PA.")]
        public string? State { get; set; }

        [StringLength(10)] public string? District { get; set; }

        public static DetailsInput From(CrmOrganization org) => new()
        {
            Name = org.Name, Kind = org.Kind, Description = org.Description, Website = org.Website,
            Address = org.Address, State = org.State, District = org.District
        };
    }
}

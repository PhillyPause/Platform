@page "/team/members"
@layout Website.Portal.Components.Layout.TeamAppLayout
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Popups
@inject VolunteerRepository Volunteers
@inject MemberAdminRepository MemberAdmin

@* Everyone who has joined, as a grid: search, sort, filter any column the way
   a spreadsheet does, a page at a time. One line a person, cut short with an
   ellipsis and whole on hover. Part of the organizers' app (TeamApp), so it
   runs interactive. Any organizer can send someone's joining email again;
   admins change roles and delete. MemberAdminRepository checks each of
   those again, whatever this page showed. *@

<PageMeta Title="Members" Description="Everyone who has joined PhillyPause." NoIndex="true" />

<div class="team-page-head">
    <div>
        <h1>Members</h1>
        <p class="team-stats">
            @_rows.Count people &middot; @_rows.Count(r => r.Status == NotConfirmed) not confirmed yet,
            so they hear about nothing new until they click the link in their joining email
        </p>
    </div>
</div>

@if (_notice is not null)
{
    <p class="team-notice" role="status">@_notice</p>
}

<SfGrid TValue="Row" DataSource="_rows" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
        Toolbar="@(new List<string> { "Search" })" GridLines="GridLine.Horizontal" RowHeight="44" CssClass="team-members">
    <GridPageSettings PageSize="25" PageSizes="PageSizes" />
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    @* No sort column to start: the rows arrive newest first to the second
       (LoadAsync), which sorting the Joined column by day alone would lose. *@
    <GridColumns>
        @* No widths: name, email and interests share what the fixed columns leave. *@
        <GridColumn Field="@nameof(Row.Name)" HeaderText="Name" ClipMode="ClipMode.EllipsisWithTooltip" />
        <GridColumn Field="@nameof(Row.Email)" HeaderText="Email" ClipMode="ClipMode.EllipsisWithTooltip" />
        @* The day, on Philadelphia's clock: the time of day says nothing an organizer needs. *@
        <GridColumn Field="@nameof(Row.Joined)" HeaderText="Joined" Type="ColumnType.Date" Format="MM/dd/yyyy" Width="116"
                    HideAtMedia="(min-width: 560px)" />
        @* Icons on screen; the words underneath are what sorting, filtering and a screen reader see. *@
        @* Phones keep who, their address and the buttons. *@
        <GridColumn Field="@nameof(Row.Status)" HeaderText="Status" Width="112" TextAlign="TextAlign.Center"
                    HideAtMedia="(min-width: 720px)">
            <Template>
                @{ var row = (Row)context; }
                <span class="e-icons @StatusIcon(row.Status) member-icon member-status-@Slug(row.Status)" role="img"
                      title="@row.Status" aria-label="@row.Status"></span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Row.Role)" HeaderText="Role" Width="100" TextAlign="TextAlign.Center"
                    HideAtMedia="(min-width: 720px)">
            <Template>
                @{ var row = (Row)context; }
                <span class="e-icons @RoleIcon(row.RoleValue) member-icon member-role-@Slug(row.Role)" role="img"
                      title="@row.Role" aria-label="@row.Role"></span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Row.Interests)" HeaderText="Likes doing" ClipMode="ClipMode.EllipsisWithTooltip"
                    HideAtMedia="(min-width: 960px)" />
        <GridColumn HeaderText="" Width="148" AllowFiltering="false" AllowSorting="false" AllowSearching="false">
            <Template>
                @{ var row = (Row)context; }
                <div class="member-actions">
                    @* Every slot is there, filled or not, so the icons line up down the column. *@
                    @if (row.CanResend)
                    {
                        <IconButton Icon="e-send" Label="@($"Send {row.Name} the joining email again")" OnClick="() => ResendAsync(row)" />
                    }
                    else
                    {
                        <span class="member-slot"></span>
                    }
                    @if (_isAdmin && row.HasEmail && row.RoleValue < VolunteerRole.Admin)
                    {
                        var up = row.RoleValue + 1;
                        <IconButton Icon="e-chevron-up" Label="@($"Make {row.Name} {Article(up)} {Lower(up)}")" OnClick="() => SetRoleAsync(row, up)" />
                    }
                    else
                    {
                        <span class="member-slot"></span>
                    }
                    @if (_isAdmin && row.HasEmail && row.RoleValue > VolunteerRole.Member)
                    {
                        var down = row.RoleValue - 1;
                        <IconButton Icon="e-chevron-down" Label="@($"Make {row.Name} {Article(down)} {Lower(down)}")" OnClick="() => SetRoleAsync(row, down)" />
                    }
                    else
                    {
                        <span class="member-slot"></span>
                    }
                    @if (_isAdmin && row.Id != _me && row.RoleValue != VolunteerRole.Admin)
                    {
                        <IconButton Icon="e-trash" Label="@($"Delete {row.Name}")" Danger="true" OnClick="() => AskDelete(row)" />
                    }
                    else
                    {
                        <span class="member-slot"></span>
                    }
                </div>
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@* Deleting cannot be undone, so it asks, and says what goes. *@
<SfDialog @bind-Visible="_deleteOpen" IsModal="true" Width="440px" ShowCloseIcon="true" CssClass="team-dialog">
    <DialogTemplates>
        <Header>Delete @_deleting?.Name?</Header>
        <Content>
            <p>
                This deletes their name, email and what they like doing, for good. Activities they
                came to still count that someone came, without them attached. They can join again.
            </p>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Delete" IsPrimary="true" OnClick="DeleteAsync" />
        <DialogButton Content="Keep them" OnClick="@(() => _deleteOpen = false)" />
    </DialogButtons>
</SfDialog>

@code {
    private const string Confirmed = "Confirmed";
    private const string NotConfirmed = "Not confirmed";
    private const string Unsubscribed = "Unsubscribed";
    private const string NoEmail = "No email";

    private static readonly string[] PageSizes = ["25", "50", "100", "All"];

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>One grid row: flat, so every column sorts and filters on a plain value.</summary>
    private sealed record Row(
        Guid Id, string Name, string Email, DateTime Joined, string Status, string Role, string Interests,
        VolunteerRole RoleValue, bool HasEmail, bool CanResend);

    private List<Row> _rows = [];
    private Guid? _me;
    private bool _isAdmin;
    private string? _notice;
    private Row? _deleting;
    private bool _deleteOpen;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
            _me = (await AuthenticationState).User.VolunteerId();

        // What to offer only; every action checks again as it runs.
        _isAdmin = _me is Guid me && await Volunteers.GetByIdAsync(me) is { } self && self.IsAtLeast(VolunteerRole.Admin);
        await LoadAsync();
    }

    // Newest first, so whoever joined at the last event is at the top. The
    // repository keeps its name order for the organizer pickers that share it.
    private async Task LoadAsync() =>
        _rows = (await Volunteers.GetMembersAsync()).OrderByDescending(m => m.CreatedAt).Select(ToRow).ToList();

    private static Row ToRow(Member m)
    {
        var status = m.Email is null ? NoEmail
            : !m.CanEmail ? Unsubscribed
            : m.Confirmed ? Confirmed
            : NotConfirmed;

        return new Row(
            m.Id, m.DisplayName, m.Email ?? string.Empty, LocalTime.ToLocal(m.CreatedAt).Date, status,
            m.Role.ToString(), string.Join(", ", m.Interests), m.Role,
            HasEmail: m.Email is not null, CanResend: status == NotConfirmed);
    }

    private async Task ResendAsync(Row row)
    {
        if (_me is not Guid me) return;

        _notice = await MemberAdmin.ResendConfirmationAsync(me, row.Id) switch
        {
            MemberActionResult.Done => $"The joining email is on its way to {row.Name} again.",
            MemberActionResult.RecentlySent =>
                $"{row.Name}'s joining email went less than {MemberAdminRepository.ResendWindow.TotalMinutes:0} minutes ago. Give it a little longer.",
            MemberActionResult.AlreadyConfirmed => $"{row.Name} has confirmed already.",
            MemberActionResult.CannotEmail => $"{row.Name} has unsubscribed, so nothing was sent.",
            MemberActionResult.NotAllowed => "Only organizers can send that.",
            _ => $"{row.Name} is not on the list any more."
        };
        await LoadAsync();
    }

    private async Task SetRoleAsync(Row row, VolunteerRole role)
    {
        if (_me is not Guid me) return;

        _notice = await MemberAdmin.SetRoleAsync(me, row.Id, role) switch
        {
            MemberActionResult.Done => $"{row.Name} is now {Article(role)} {Lower(role)}.",
            MemberActionResult.LastAdmin => "That is the last admin. Make someone else an admin first.",
            MemberActionResult.NotAllowed => "Only admins change roles.",
            _ => $"{row.Name} is not on the list any more."
        };
        await LoadAsync();
    }

    private void AskDelete(Row row)
    {
        _deleting = row;
        _deleteOpen = true;
    }

    private async Task DeleteAsync()
    {
        _deleteOpen = false;
        if (_me is not Guid me || _deleting is not { } row) return;

        _notice = await MemberAdmin.DeleteAsync(me, row.Id) switch
        {
            MemberActionResult.Done => $"{row.Name} is deleted.",
            MemberActionResult.IsAdmin => $"{row.Name} is an admin. Make them an organizer first.",
            MemberActionResult.Self => "Your own page has the button for deleting yourself.",
            MemberActionResult.NotAllowed => "Only admins delete people.",
            _ => $"{row.Name} is not on the list any more."
        };
        _deleting = null;
        await LoadAsync();
    }

    private static string StatusIcon(string status) => status switch
    {
        Confirmed => "e-circle-check",
        NotConfirmed => "e-clock",
        Unsubscribed => "e-circle-close",
        _ => "e-close"
    };

    private static string RoleIcon(VolunteerRole role) => role switch
    {
        VolunteerRole.Admin => "e-star-filled",
        VolunteerRole.Organizer => "e-people",
        _ => "e-user"
    };

    private static string Slug(string words) => words.ToLowerInvariant().Replace(' ', '-');

    private static string Lower(VolunteerRole role) => role.ToString().ToLowerInvariant();

    private static string Article(VolunteerRole role) => role == VolunteerRole.Admin ? "an" : "a";
}

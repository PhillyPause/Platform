@page "/team/activity/{Id:guid}"
@inject ActivityAdminRepository Admin

<PageMeta Title="@(_activity?.Title ?? "Activity")" Description="An activity's roster." NoIndex="true" />

@if (_activity is null)
{
    return;
}

<header class="mh-page-head">
    <div>
        <p class="mh-crumb"><a href="@ManyHandsPaths.Team" data-enhance-nav="false">Activities</a></p>
        <div class="mh-title-row">
            <h1>@_activity.Title</h1>
            @if (_activity.IsPublished)
            {
                <span class="mh-badge mh-badge-ok">Published</span>
            }
            else
            {
                <span class="mh-badge mh-badge-warn">Draft</span>
            }
        </div>
        <p class="mh-meta">
            <span>@Show.When(_activity.StartsAt)</span>
            <span>@Show.Where(_activity.Location)</span>
        </p>
    </div>
    <div class="mh-page-actions">
        <EditForm Model="Publish" FormName="publish" OnSubmit="TogglePublishedAsync">
            @if (_activity.IsPublished)
            {
                <button class="mh-btn mh-btn-secondary" type="submit">Unpublish</button>
            }
            else
            {
                <button class="mh-btn mh-btn-primary" type="submit">Publish, and tell people who like this</button>
            }
        </EditForm>
        <a class="mh-btn mh-btn-secondary" href="@ManyHandsPaths.TeamEditActivity(Id)">Edit</a>
        @if (_activity.IsPublished)
        {
            <a class="mh-btn mh-btn-secondary" href="@ManyHandsPaths.TeamCheckInCode(Id)">Check-in code for the door</a>
            <a class="mh-btn mh-btn-secondary" href="@ManyHandsPaths.Activity(Id)">See the public page</a>
        }
    </div>
</header>

@if (_notice is not null)
{
    <p class="mh-notice" role="status">@_notice</p>
}

<div class="mh-cards mh-roster-numbers">
    <div class="mh-card">
        <span class="mh-card-label">Signed up</span>
        <p class="mh-card-figure">@_roster.Count(r => r.Status == SignupStatus.Confirmed)</p>
        <p class="mh-card-text">@(_activity.Capacity is { } cap ? $"of {cap} places" : "no limit")</p>
    </div>
    <div class="mh-card">
        <span class="mh-card-label">Checked in</span>
        <p class="mh-card-figure">@_roster.Count(r => r.CheckedInAt is not null)</p>
        <p class="mh-card-text">at the door, so far</p>
    </div>
    <div class="mh-card">
        <span class="mh-card-label">Waitlist</span>
        <p class="mh-card-figure">@_roster.Count(r => r.Status == SignupStatus.Waitlisted)</p>
        <p class="mh-card-text">waiting for a place</p>
    </div>
</div>

<div class="mh-columns mh-section">
    <section class="mh-panel" aria-labelledby="roster-head">
        <div class="mh-panel-head">
            <h2 id="roster-head">Who is coming</h2>
            @if (_roster.Count > 0)
            {
                <p>Press a name to check them in, or press it again to undo.</p>
            }
        </div>

        @if (_roster.Count == 0)
        {
            <div class="mh-empty">
                <p class="mh-empty-title">Nobody yet</p>
                <p>
                    @(_activity.IsPublished
                        ? "Signups appear here as they come in. At the door, add anyone who turns up without one."
                        : "It is a draft, so nobody can sign up. Publish it and the people who like this kind of thing are told.")
                </p>
            </div>
        }
        else
        {
            <EditForm Model="Toggle" FormName="check-in" OnSubmit="ToggleCheckInAsync">
                <ul class="mh-roster">
                    @foreach (var entry in _roster)
                    {
                        <li class="@(entry.CheckedInAt is not null ? "is-in" : null)">
                            @* The pressed button posts its own value: the signup, and which way to flip it. *@
                            <button type="submit" name="Toggle.Value" value="@($"{entry.SignupId}:{entry.CheckedInAt is null}")"
                                    aria-pressed="@(entry.CheckedInAt is not null ? "true" : "false")">
                                <span class="mh-tick" aria-hidden="true">@(entry.CheckedInAt is not null ? "✓" : "")</span>
                                <span>
                                    <strong>@entry.DisplayName</strong>
                                    <span class="mh-small">
                                        @entry.Email
                                        @if (entry.Status == SignupStatus.Waitlisted) { <text> &middot; waitlist</text> }
                                        @if (entry.Source == SignupSource.Organizer) { <text> &middot; walk-in</text> }
                                    </span>
                                </span>
                                @if (entry.CheckedInAt is not null)
                                {
                                    <span class="mh-badge mh-badge-ok mh-in-word" aria-hidden="true">In</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </EditForm>
        }
    </section>

    <section class="mh-panel" aria-labelledby="walk-in-head">
        <h2 id="walk-in-head">Somebody turned up without signing up</h2>
        <EditForm Model="WalkIn" FormName="walk-in" OnValidSubmit="AddWalkInAsync" class="mh-form">
            <DataAnnotationsValidator />
            <label class="mh-field">
                <span class="mh-label">Name</span>
                <InputText @bind-Value="WalkIn!.DisplayName" />
                <ValidationMessage For="() => WalkIn!.DisplayName" />
            </label>
            <label class="mh-field">
                <span class="mh-label">Email <span class="mh-optional">(optional)</span></span>
                <InputText @bind-Value="WalkIn!.Email" type="email" />
                <span class="mh-help">If they want to hear about the next one.</span>
            </label>
            <div class="mh-form-actions">
                <button class="mh-btn mh-btn-secondary" type="submit">Add and check in</button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "publish")] private PublishInput? Publish { get; set; }
    [SupplyParameterFromForm(FormName = "check-in")] private ToggleInput? Toggle { get; set; }
    [SupplyParameterFromForm(FormName = "walk-in")] private WalkInInput? WalkIn { get; set; }

    private ActivityDraft? _activity;
    private IReadOnlyList<RosterEntry> _roster = [];
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        Publish ??= new();
        Toggle ??= new();
        WalkIn ??= new();
        await LoadAsync();

        if (_activity is null) HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }

    private async Task LoadAsync()
    {
        _activity = await Admin.GetAsync(Id);
        if (_activity is not null) _roster = await Admin.GetRosterAsync(Id);
    }

    private async Task TogglePublishedAsync()
    {
        var publish = !_activity!.IsPublished;
        if (await Admin.SetPublishedAsync(Id, publish))
            _notice = publish
                ? "Published. People whose interests match are being told now."
                : "Unpublished. It is off the public list; signups stay as they were.";
        await LoadAsync();
    }

    private async Task ToggleCheckInAsync()
    {
        var parts = Toggle!.Value?.Split(':') ?? [];
        if (parts.Length == 2 && Guid.TryParse(parts[0], out var signupId) && bool.TryParse(parts[1], out var checkIn))
            await Admin.SetCheckedInAsync(signupId, checkIn);
        await LoadAsync();
    }

    private async Task AddWalkInAsync()
    {
        _notice = await Admin.AddWalkInAsync(Id, WalkIn!.DisplayName, WalkIn.Email)
            ? $"{WalkIn.DisplayName.Trim()} is in, and checked in."
            : "That email does not look right. Leave it blank if they would rather not give one.";
        WalkIn = new();
        await LoadAsync();
    }

    private sealed class PublishInput;

    private sealed class ToggleInput
    {
        public string? Value { get; set; }
    }

    private sealed class WalkInInput
    {
        [Required(ErrorMessage = "A name, so the count means something.")]
        [StringLength(100)]
        public string DisplayName { get; set; } = string.Empty;

        [StringLength(254)]
        public string? Email { get; set; }
    }
}

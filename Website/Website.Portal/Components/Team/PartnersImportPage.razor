@page "/team/partners/import"
@inject PartnerRepository Partners

@* The Partner Tracker sheet, brought in by pasting: select a tab's cells
   with their heading row, copy, paste. A CSV saved from the sheet works the
   same. Running it again is safe: organizations are found by name, and what
   an organizer has set on one is kept. PauseAI US is refused (CLAUDE.md). *@

<PageMeta Title="Import partners" Description="Bring the Partner Tracker sheet into ManyHands." NoIndex="true" />

<div class="wrap page-head">
    <h1>Import partners</h1>
    <p class="lead">
        In the Partner Tracker sheet, select a tab&rsquo;s cells, heading row included, copy, and paste
        them here. A CSV file&rsquo;s text works too. Running it again changes nothing that is already set.
    </p>
</div>

<div class="wrap vol-body vol-stack">
    @if (_report is { } report)
    {
        <div class="vol-notice" role="status">
            <p>
                @report.Added added, @report.Updated already here (only their blanks filled),
                @report.LinksAdded @(report.LinksAdded == 1 ? "link" : "links") between organizations added.
                <a href="@ManyHandsPaths.TeamPartners">See the partners</a>.
            </p>
            @if (report.Refused.Count > 0)
            {
                <p>Left out, because PhillyPause does not contact them: @string.Join(", ", report.Refused).</p>
            }
            @if (report.Problems.Count > 0)
            {
                <ul>
                    @foreach (var problem in report.Problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            }
        </div>
    }

    <EditForm Model="Input" FormName="import" OnValidSubmit="ImportAsync" class="vol-form vol-editor">
        <DataAnnotationsValidator />
        <label>
            <span>Partners tab: Organization, Priority, Status, Category, Contact channel, Why they fit, Link, Found via, Tracking code, Notes</span>
            <InputTextArea @bind-Value="Input!.Partners" rows="10" spellcheck="false" />
        </label>
        <label>
            <span>Org links tab: From, Connection, To, Source</span>
            <InputTextArea @bind-Value="Input!.Links" rows="6" spellcheck="false" />
        </label>
        <ValidationMessage For="() => Input!.Partners" />
        <button class="btn" type="submit">Import</button>
    </EditForm>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "import")] private ImportInput? Input { get; set; }

    private PartnerImportReport? _report;

    protected override void OnInitialized() => Input ??= new();

    private async Task ImportAsync()
    {
        _report = await Partners.ImportAsync(Input!.Partners, Input.Links, HttpContext.User.VolunteerId());
        Input = new();
    }

    private sealed class ImportInput : IValidatableObject
    {
        [StringLength(500_000)] public string? Partners { get; set; }
        [StringLength(200_000)] public string? Links { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            if (string.IsNullOrWhiteSpace(Partners) && string.IsNullOrWhiteSpace(Links))
                yield return new("Paste at least one tab.", [nameof(Partners)]);
        }
    }
}

@page "/team/inbox/templates"
@inject CrmEmailRepository Emails

<PageMeta Title="Templates" Description="Outreach email templates." NoIndex="true" />

<header class="mh-page-head">
    <div>
        <p class="mh-crumb"><a href="@ManyHandsPaths.Inbox">Inbox</a></p>
        <h1>Templates</h1>
        <p class="mh-summary">Letters the team sends often. Start a new email from one and change what needs changing.</p>
    </div>
</header>

<div class="mh-columns">
    <section class="mh-panel" aria-labelledby="list-head">
        <div class="mh-panel-head">
            <h2 id="list-head">The team&rsquo;s templates</h2>
            @if (_templates.Count > 0) { <p>Press one to write from it</p> }
        </div>
        @if (_templates.Count == 0)
        {
            <div class="mh-empty">
                <p class="mh-empty-title">No templates yet</p>
                <p>Save a letter you send often with the form here, and it shows up under Start from when anyone writes.</p>
            </div>
        }
        else
        {
            <EditForm Model="Remove" FormName="remove" OnSubmit="RemoveAsync">
                <ul class="mh-list">
                    @foreach (var template in _templates)
                    {
                        <li>
                            <div class="mh-list-main">
                                <a href="@($"{ManyHandsPaths.InboxCompose}?template={template.Id}")">@template.Name</a>
                                <div class="mh-meta"><span>@template.Subject</span></div>
                            </div>
                            <div class="mh-list-end">
                                <button class="mh-btn mh-btn-quiet" type="submit" name="Remove.Id" value="@template.Id"
                                        aria-label="@($"Remove {template.Name}")">Remove</button>
                            </div>
                        </li>
                    }
                </ul>
            </EditForm>
        }
    </section>

    <section class="mh-panel" aria-labelledby="new-head">
        <h2 id="new-head">A new template</h2>
        <EditForm Model="Input" FormName="template" OnValidSubmit="AddAsync" class="mh-form">
            <DataAnnotationsValidator />
            <label class="mh-field">
                <span class="mh-label">Name, for the team</span>
                <InputText @bind-Value="Input!.Name" placeholder="Meeting request" />
                <ValidationMessage For="() => Input!.Name" />
            </label>
            <label class="mh-field"><span class="mh-label">Subject</span><InputText @bind-Value="Input!.Subject" /><ValidationMessage For="() => Input!.Subject" /></label>
            <label class="mh-field"><span class="mh-label">Message</span><InputTextArea @bind-Value="Input!.Body" rows="10" /><ValidationMessage For="() => Input!.Body" /></label>
            <div class="mh-form-actions">
                <button class="mh-btn mh-btn-primary" type="submit">Save</button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    [SupplyParameterFromForm(FormName = "template")] private TemplateInput? Input { get; set; }
    [SupplyParameterFromForm(FormName = "remove")] private RemoveInput? Remove { get; set; }

    private IReadOnlyList<CrmEmailTemplate> _templates = [];

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        Remove ??= new();
        _templates = await Emails.GetTemplatesAsync();
    }

    private async Task AddAsync()
    {
        await Emails.AddTemplateAsync(Input!.Name.Trim(), Input.Subject.Trim(), Input.Body.Trim());
        Input = new();
        _templates = await Emails.GetTemplatesAsync();
    }

    private async Task RemoveAsync()
    {
        if (Remove!.Id is Guid id) await Emails.DeleteTemplateAsync(id);
        _templates = await Emails.GetTemplatesAsync();
    }

    private sealed class TemplateInput
    {
        [Required(ErrorMessage = "Give it a name.")] [StringLength(100)] public string Name { get; set; } = string.Empty;
        [Required(ErrorMessage = "Give it a subject.")] [StringLength(300)] public string Subject { get; set; } = string.Empty;
        [Required(ErrorMessage = "Write the letter.")] [StringLength(20_000)] public string Body { get; set; } = string.Empty;
    }

    private sealed class RemoveInput
    {
        public Guid? Id { get; set; }
    }
}

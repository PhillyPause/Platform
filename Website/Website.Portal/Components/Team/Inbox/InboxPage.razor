@page "/team/inbox"
@inject CrmEmailRepository Emails
@inject ManyHands.Data.Email.OutreachEmail Outreach

<PageMeta Title="Inbox" Description="PhillyPause's outreach mail." NoIndex="true" />

<header class="mh-page-head">
    <div>
        <h1>Inbox</h1>
        <p class="mh-summary">
            Outreach mail to and from @Outreach.Mailbox, whoever sent it. Nothing lives in anyone&rsquo;s
            personal inbox, so a conversation survives the person who started it.
        </p>
    </div>
    <div class="mh-page-actions">
        <a class="mh-btn mh-btn-primary" href="@ManyHandsPaths.InboxCompose">Write</a>
        <a class="mh-btn mh-btn-secondary" href="@ManyHandsPaths.InboxTemplates">Templates</a>
    </div>
</header>

<nav class="mh-filter" aria-label="Which threads">
    <a href="@ManyHandsPaths.Inbox" aria-current="@(!Triage ? "page" : null)">Everything</a>
    <a href="@($"{ManyHandsPaths.Inbox}?triage=true")" aria-current="@(Triage ? "page" : null)">From people we do not know yet</a>
</nav>

@if (_threads.Count == 0)
{
    <div class="mh-empty">
        @if (Triage)
        {
            <p class="mh-empty-title">Nobody waiting to be identified</p>
            <p>Mail from an address no contact has lands here, so someone can say who sent it.</p>
        }
        else
        {
            <p class="mh-empty-title">No mail yet</p>
            <p>Write to an office or a partner, and their replies come back here, threaded.</p>
            <a class="mh-btn mh-btn-secondary" href="@ManyHandsPaths.InboxCompose">Write the first one</a>
        }
    </div>
}
else
{
    <div class="mh-table-wrap">
        <table class="mh-table mh-table-stack">
            <thead><tr><th scope="col">Conversation</th><th scope="col">With</th><th scope="col">Last</th></tr></thead>
            <tbody>
                @foreach (var thread in _threads)
                {
                    <tr>
                        <td>
                            <a href="@ManyHandsPaths.InboxThread(thread.ConversationId)">@thread.Subject</a>
                            @if (thread.NeedsTriage) { <span class="mh-badge mh-badge-warn">Who is this?</span> }
                        </td>
                        <td data-label="With">
                            @(thread.ContactName ?? (thread.Direction == EmailDirection.Inbound ? thread.FromAddress : thread.ToAddress))
                            @if (thread.OrganizationName is { } org) { <span class="mh-small">@org</span> }
                        </td>
                        <td data-label="Last">
                            @Show.Stamp(thread.LastMessageAt)
                            <span class="mh-small">@thread.MessageCount @(thread.MessageCount == 1 ? "message" : "messages")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "triage")] private bool Triage { get; set; }

    private IReadOnlyList<EmailThreadSummary> _threads = [];

    protected override async Task OnInitializedAsync() => _threads = await Emails.GetThreadsAsync(Triage);
}

@page "/act/yours"
@inject OfficialsStore Officials
@inject IConfiguration Configuration

@* Your six (YourSix): a reader's own officials, in the order the path takes
   them, from the districts in the query string (ActPaths.Yours), never the
   address. A Philadelphian's councilmember is the member for the council
   district they choose (cc=), which the Census geocoder cannot tell us.

   A signed-in member sees it as the path's third step: one marked Start
   here, the rest to take one at a time, each link carrying the districts so
   the call or write page can say who is next. Everyone else sees the basic
   route: all of them, how a call and an email go in three lines each, the
   ask, and the way to everyone else. *@

<PageMeta Title="Your officials" Description="Your officials in Washington, Harrisburg and Greater Philadelphia, with their numbers and a script." NoIndex="true" />

<Home>
    <ActView>
        @if (Member)
        {
            <PathSteps Current="3" />
        }
        <header class="act-intro">
            <h2>@(Member ? "Your six" : "Your officials")</h2>
            <p class="act-lead">
                @if (_match.IsEmpty)
                {
                    <text>Tell us your districts and we will show you who to call.</text>
                }
                else
                {
                    @Describe(_match)
                }
            </p>
        </header>

        @if (!Member)
        {
            <JoinInvite Lead="Want help with what comes next?" />
        }

        @if (_match.IsEmpty)
        {
            <DistrictPicker />
        }
        else
        {
            @if (Member && _six.StartHere is { } first)
            {
                <section class="act-start-here" aria-labelledby="start-head">
                    <h3 id="start-head" class="act-kicker">Start here</h3>
                    <ul class="act-cards">
                        <OfficialCard Official="first" Six="_six" Featured="true" />
                    </ul>
                    <p class="act-small">@WhyFirst(first)</p>
                </section>

                @if (_six.People.Count > 1)
                {
                    <section class="act-group" aria-labelledby="then-head">
                        <h3 id="then-head" class="act-section-head">Then, one at a time</h3>
                        <ol class="act-cards act-cards-then">
                            @foreach (var official in _six.People.Skip(1))
                            {
                                <OfficialCard Official="official" Six="_six" />
                            }
                        </ol>
                    </section>
                }
                <CouncilChips Six="_six" />
            }
            else if (_six.People.Count > 0)
            {
                <section class="act-group" aria-labelledby="group-head">
                    <h3 id="group-head" class="act-section-head">Who represents you</h3>
                    <ul class="act-cards">
                        @foreach (var official in _six.People)
                        {
                            <OfficialCard Official="official" Six="_six" />
                        }
                    </ul>
                    <CouncilChips Six="_six" />
                    @if (Writable(_six.People) is { Count: > 1 } writable)
                    {
                        <p class="act-merge-cta">
                            <a class="act-btn" href="@ActPaths.WriteTo(writable)">Write to all @writable.Count at once</a>
                            <span class="act-small">One message, a copy to each, with their names filled in.</span>
                        </p>
                    }
                </section>

                <section class="act-howto" aria-labelledby="howto-head">
                    <h3 id="howto-head" class="act-section-head">How to do it, in three lines</h3>
                    <div class="act-ask-grid">
                        <div>
                            <h4>A call</h4>
                            <ol>
                                <li>Your name, and your zip code, so they know you are a constituent.</li>
                                <li>The ask, in a sentence: below, for each of them.</li>
                                <li>&ldquo;Where do they stand?&rdquo; Then thank them.</li>
                            </ol>
                        </div>
                        <div>
                            <h4>An email</h4>
                            <ol>
                                <li>Who you are, and where you live.</li>
                                <li>The ask, in one sentence, and why it matters to you.</li>
                                <li>A request for their position, in writing.</li>
                            </ol>
                        </div>
                    </div>
                </section>

                <AskGrid Heading="What to ask each of them for" />
            }
            else
            {
                <p class="act-empty">Nobody here yet for your districts. <a href="@ActPaths.Directory">Search the directory</a> or <a href="#by-district">change your districts</a>.</p>
                <CouncilChips Six="_six" />
            }

            <p class="act-small act-yours-more">
                Everyone else, from the Governor to City Hall, is in the <a href="@ActPaths.Directory">directory</a>.
            </p>

            <DistrictPicker />
        }
    </ActView>
</Home>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "cd")] private string? Congressional { get; set; }
    [SupplyParameterFromQuery(Name = "ss")] private string? StateSenate { get; set; }
    [SupplyParameterFromQuery(Name = "sh")] private string? StateHouse { get; set; }
    [SupplyParameterFromQuery(Name = "county")] private string? County { get; set; }
    [SupplyParameterFromQuery(Name = "cc")] private string? CouncilDistrict { get; set; }

    private DistrictMatch _match = new(null, null, null, null);
    private YourSix _six = default!;

    private bool Member => Configuration.IsManyHandsEnabled() && HttpContext?.User.VolunteerId() is not null;

    protected override void OnParametersSet()
    {
        _match = YourSix.Read(Congressional, StateSenate, StateHouse, County);
        _six = YourSix.For(Officials, _match, DistrictMatch.Normalise(CouncilDistrict), DateOnly.FromDateTime(DateTime.UtcNow));
    }

    // Everyone here who takes a message, but not someone leaving office: a
    // merge goes to the people who will still be there to act.
    private static IReadOnlyList<Official> Writable(IReadOnlyList<Official> people) =>
        people.Where(o => o.CanEmail && o.Status != OfficialStatus.Departing).Take(MailMerge.Most).ToArray();

    private static string WhyFirst(Official first) => first.Level switch
    {
        OfficialLevel.Federal when !first.IsSenator =>
            "Congress is where a pause would be decided, and a House office counts calls from its own district above all.",
        OfficialLevel.Federal => "Congress is where a pause would be decided. Add your US House district to start with your own representative.",
        _ => "The first of yours we know. Add your US House district to start with your representative in Congress."
    };

    private static string Describe(DistrictMatch m)
    {
        var bits = new List<string>();
        if (m.County is not null) bits.Add(m.County == "Philadelphia" ? "Philadelphia" : $"{m.County} County");
        if (m.Congressional is not null) bits.Add($"PA-{m.Congressional}");
        if (m.StateSenate is not null) bits.Add($"State Senate {m.StateSenate}");
        if (m.StateHouse is not null) bits.Add($"State House {m.StateHouse}");
        return $"For {string.Join(", ", bits)}. Call first if you can: it takes five minutes.";
    }
}

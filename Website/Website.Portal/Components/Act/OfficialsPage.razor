@page "/act/officials"
@inject OfficialsStore Officials

@* The whole directory, or one county's share of it, in the Act dialog: the
   county map's links land here with ?county=. *@

<PageMeta Title="@Heading()"
          Description="Pennsylvania's senators, the House members, statewide officers, the General Assembly, the City of Philadelphia and the collar counties, with their numbers." />

<Home>
    <ActView>
        <header class="act-intro act-intro-map">
            <div>
                <h2>@Heading()</h2>
                <p class="act-lead">
                    @if (_county is null)
                    {
                        <text>The five counties, from Washington to City Hall. Choose a county to narrow it, or <a href="@ActPaths.Start">find your own</a> by address.</text>
                    }
                    else
                    {
                        <text>Everyone whose seat covers part of @Place(_county), plus the two senators and the statewide officers. <a href="@ActPaths.Everyone">Show all five counties</a>.</text>
                    }
                </p>
            </div>
            <CountyMap Selected="@_county" />
        </header>

        @foreach (var group in _people.GroupBy(o => o.Level))
        {
            <section class="act-group" aria-labelledby="level-@group.Key">
                <h3 id="level-@group.Key" class="act-section-head">@LevelHeading(group.Key)</h3>
                <ul class="act-cards">
                    @foreach (var official in group)
                    {
                        <OfficialCard Official="official" />
                    }
                </ul>
            </section>
        }
        @if (_people.Count == 0)
        {
            <p class="act-empty">Nobody in the directory for that yet.</p>
        }
    </ActView>
</Home>

@code {
    [SupplyParameterFromQuery(Name = "county")] private string? County { get; set; }

    private string? _county;
    private IReadOnlyList<Official> _people = [];

    protected override void OnParametersSet()
    {
        _county = DistrictMatch.NormaliseCounty(County);
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _people = (_county is null ? Officials.Current(today) : Officials.InCounty(_county, today)).ToArray();
    }

    private string Heading() =>
        _county is null ? "Everyone who represents Greater Philadelphia" : $"Who represents {Place(_county)}";

    private static string Place(string county) => county == "Philadelphia" ? "Philadelphia" : $"{county} County";

    private static string LevelHeading(OfficialLevel level) => level switch
    {
        OfficialLevel.Federal => "Congress",
        OfficialLevel.StateExecutive => "Pennsylvania: statewide",
        OfficialLevel.StateSenate => "Pennsylvania Senate",
        OfficialLevel.StateHouse => "Pennsylvania House",
        OfficialLevel.City => "City of Philadelphia",
        OfficialLevel.County => "County government",
        _ => level.ToString()
    };
}

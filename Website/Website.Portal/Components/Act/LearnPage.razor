@page "/act/learn"
@page "/act/learn/{Page}"
@inject ContentStore Content
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@using ManyHands.Data

@* The explainers, in the Act dialog: Markdown in Content/act/learn, rendered
   here rather than by ContentRoute, so the reader stays in the dialog. A
   volunteer who can write Markdown can add one. *@

@if (_page is not null)
{
    <PageMeta Title="@_page.Title" Description="@_page.Description" />

    <Home>
        <ActView>
            <header class="act-intro">
                <p class="act-kicker">How it works</p>
                <h2>@_page.Title</h2>
                <p class="act-lead">@_page.Description</p>
            </header>

            <article class="prose act-prose">
                @((MarkupString)Content.HtmlFor(_page, Configuration.IsManyHandsEnabled()))
            </article>
            <SourceCredit Page="_page" />
            @if (Page is not null)
            {
                <p class="act-small"><a href="@ActPaths.Learn">All the explainers</a> &middot; <a href="@ActPaths.Start">Find who represents you</a></p>
            }
        </ActView>
    </Home>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Parameter] public string? Page { get; set; }

    private ContentPage? _page;

    protected override void OnParametersSet()
    {
        _page = Content.Find(Page is null ? "act/learn" : $"act/learn/{Page}");
        if (_page is null && HttpContext is not null) Navigation.NotFound();
    }
}

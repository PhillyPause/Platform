@inject IConfiguration Configuration

@* ACT's first view, which the front page also draws in place behind the ACT
   button, and /act opens with the dialog showing. Who is reading decides
   what it is:
   - with ManyHands off there are no members, so it is the basic route's
     start (BasicStart), as ACT has always been;
   - not signed in, it is sign in or join (ActGate), and choosing neither
     leads to the basic route at /act/find;
   - a signed-in member is on the path, at its first step (PathLearn). *@

@if (!Configuration.IsManyHandsEnabled())
{
    <BasicStart Action="@ActPaths.Start" />
}
else if (HttpContext?.User.VolunteerId() is null)
{
    <ActGate Joined="@(Joined is not null)" Again="@(Again is not null)" />
}
else
{
    <PathLearn />
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Set by the join form on ACT's first screen, once it has sent the email.
    [SupplyParameterFromQuery(Name = "joined")] private string? Joined { get; set; }

    [SupplyParameterFromQuery(Name = "again")] private string? Again { get; set; }
}

@inject IOptions<ActOptions> Options

@* Whether the seat is theirs yet, and, in development only, whether anybody
   has checked the entry. Production never shows the second: it is a note to
   the people editing the directory, not to readers. *@

@if (Official.Status == OfficialStatus.MemberElect)
{
    <p class="act-status act-status-elect">Elected; takes office @(Official.Level == OfficialLevel.Federal ? "January 3, 2027" : "in January")</p>
}
else if (Official.Status == OfficialStatus.Departing)
{
    <p class="act-status act-status-leaving">Leaving office@(Official.TermEnds is { } end ? $" {end:MMMM d, yyyy}" : "")</p>
}
@if (Options.Value.ShowUnverified && !Official.Verified)
{
    <p class="act-status act-status-check" role="note">Needs checking: drafted from research, not yet confirmed against the office&rsquo;s own site</p>
}

@code {
    [Parameter, EditorRequired] public required Official Official { get; set; }
}

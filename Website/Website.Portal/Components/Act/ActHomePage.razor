@page "/act"
@inject IDistrictLookup Lookup
@inject ActThrottle Throttle
@inject NavigationManager Navigation
@inject OfficialsStore Officials
@inject IMessageDrafter Drafter

@* The front door of the action centre: find who represents you, then call or
   write. Static server rendering, like every public page: the address form
   posts here and lands on /act/yours with the district numbers in the address
   bar, never the address itself. *@

<PageMeta Title="Contact your representatives"
          Description="Find who represents you in Washington, Harrisburg and Greater Philadelphia, and call or write to them about AI in fifteen minutes. A script, a draft in your own words, and the numbers to call." />

<div class="act-hero">
    <div class="wrap">
        <p class="act-kicker">Act</p>
        <h1>Tell the people who represent you</h1>
        <p class="act-lead">
            Offices count every constituent who gets in touch. On AI, almost nobody has, so yours is not one
            of thousands. It is one of a handful. Fifteen minutes, a phone or an email, and your address.
        </p>

        <section class="act-find" aria-labelledby="find-head">
            <h2 id="find-head">Who represents you?</h2>
            @if (Lookup.IsAvailable)
            {
                <EditForm Model="Input" FormName="find" OnValidSubmit="FindAsync" class="act-form act-find-form">
                    <DataAnnotationsValidator />
                    <label>
                        <span>Your street address</span>
                        <InputText @bind-Value="Input!.Address" autocomplete="street-address" placeholder="1400 John F Kennedy Blvd, Philadelphia, PA 19107" />
                        <ValidationMessage For="() => Input!.Address" />
                    </label>
                    <button class="act-btn" type="submit">Find them</button>
                </EditForm>
                @if (_problem is not null)
                {
                    <p class="act-error" role="alert">@_problem</p>
                }
                <p class="act-small">
                    The address goes to the US Census Bureau&rsquo;s geocoder to find your districts. We do not keep it,
                    and it never appears in the page&rsquo;s address. Rather not? <a href="#by-district">Pick your districts instead</a>.
                </p>
            }
            <DistrictPicker />
        </section>
    </div>
</div>

<div class="wrap act-body">
    <section class="act-ways" aria-labelledby="ways-head">
        <h2 id="ways-head" class="act-section-head">Three ways in, smallest first</h2>
        <ul class="act-ways-list">
            <li>
                <h3>Call</h3>
                <p>Five minutes with a script. A staffer answers, writes down your name and what you asked, and adds it to the count the member sees.</p>
            </li>
            <li>
                <h3>Write</h3>
                <p>
                    Ten minutes. Tell us in a sentence why it matters to you and we lay out a first draft in your words,
                    for you to change and send yourself@(Drafter.UsesAi ? ", with help from an AI model if you want it" : "").
                </p>
            </li>
            <li>
                <h3>Meet</h3>
                <p>An hour, and you will not be on your own. One of us has taken this to Congress more than seventy-five times. <a href="/join" data-enhance-nav="false">Join us</a> and come along.</p>
            </li>
        </ul>
    </section>

    <div class="act-tuts">
        <HowToCall />
        <HowToWrite />
    </div>

    <section class="act-ask" aria-labelledby="ask-head">
        <h2 id="ask-head" class="act-section-head">What we are asking for</h2>
        <div class="act-ask-grid">
            <div>
                <h3>In Washington</h3>
                <p>An international pause on building ever more powerful AI systems until they can be shown to be safe, and no federal ban on states passing their own AI safety laws.</p>
            </div>
            <div>
                <h3>In Harrisburg</h3>
                <p>Binding safety rules in Pennsylvania for the companies building the most powerful systems, and a clear word to our delegation in Washington.</p>
            </div>
            <div>
                <h3>Here at home</h3>
                <p>AI safety on the public record: a resolution calling on Congress to pause, and questions put to the people who represent us there.</p>
            </div>
        </div>
        <p class="act-small"><a href="/act/learn/the-ask">Why these, and how to say them &rarr;</a></p>
    </section>

    <section class="act-browse" aria-labelledby="browse-head">
        <div>
            <h2 id="browse-head" class="act-section-head">Everyone, county by county</h2>
            <p>
                @Officials.All.Count people in the directory: Pennsylvania&rsquo;s senators and the House members for the
                five counties, the governor and statewide officers, the General Assembly, the City of Philadelphia
                and the collar counties&rsquo; commissioners.
            </p>
            <p><a class="act-btn act-btn-ghost" href="/act/officials">See everyone</a></p>
        </div>
        <CountyMap />
    </section>

    <section class="act-learn" aria-labelledby="learn-head">
        <h2 id="learn-head" class="act-section-head">Before you pick up the phone</h2>
        <ul class="act-learn-list">
            <li><a href="/act/learn/calling">What happens when you call</a><span>Who answers, what they write down, and what to do about voicemail.</span></li>
            <li><a href="/act/learn/writing">Writing that gets read</a><span>Short, local, one ask. Why your own words beat a perfect letter.</span></li>
            <li><a href="/act/learn/who-does-what">Who does what on AI</a><span>Congress, Harrisburg, City Hall and the counties, and what each can actually do.</span></li>
            <li><a href="/act/learn/bills">AI bills to watch</a><span>What is moving in Washington and Harrisburg, and where your officials stand.</span></li>
            <li><a href="/act/learn/meeting">Meeting them in person</a><span>How to ask for a meeting, what to bring, and how to follow up.</span></li>
        </ul>
    </section>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "find")] private FindInput? Input { get; set; }

    private string? _problem;

    protected override void OnInitialized() => Input ??= new();

    private async Task FindAsync()
    {
        if (!Throttle.AllowLookup(HttpContext))
        {
            _problem = "That is a lot of lookups in a short time. Wait a few minutes, or pick your districts below.";
            return;
        }

        var match = await Lookup.LookupAsync(Input!.Address.Trim(), HttpContext.RequestAborted);
        if (match is null)
        {
            _problem = "We could not find that address. Check the spelling and the zip code, or pick your districts below.";
            return;
        }

        if (!match.InPennsylvania)
        {
            _problem = "That address is outside Pennsylvania. This directory covers Greater Philadelphia; elsewhere, your state legislature's site will say who represents you.";
            return;
        }

        Navigation.NavigateTo(YourOfficialsPage.UrlFor(match));
    }

    private sealed class FindInput
    {
        [Required(ErrorMessage = "Enter your street address, with the zip code.")]
        [StringLength(200, ErrorMessage = "That is longer than any address.")]
        public string Address { get; set; } = string.Empty;
    }
}

@page "/"
@page "/join"
@layout BroadsheetLayout
@using ManyHands.Core
@using ManyHands.Data
@using ManyHands.Data.Workers
@inject NavigationManager Navigation
@inject UpcomingActivities Upcoming
@inject IConfiguration Configuration

@* The home page, as a broadsheet front: masthead and nav, the lead story on
   the July 2026 incident, and the dialogs: watch, panelists, join us, the
   primer, volunteer, educate, organize and the small print.

   The dialogs are driven by one hidden radio group and `:checked ~` sibling
   selectors, not script. Radios rather than checkboxes so that opening one
   closes the last and a link inside a dialog can hand the reader to another.
   That is deliberate: the page is statically rendered (Docs/PLAN.md section
   2.1), and nothing here needs a WASM download.

   The styling lives in wwwroot/broadsheet.css rather than a scoped stylesheet,
   because scoped CSS rewrites the sibling selectors the dialogs depend on. *@

<PageMeta Title="Stop the AI death race"
          Description="In July 2026, 700 AI agents broke out of their sandboxes to cheat on a test. PhillyPause is an independent, volunteer-run Philadelphia organisation working to stop the AI death race."
          Canonical="@(JoinOpen ? Navigation.BaseUri : null)" />


<div class="broadsheet" style="background: #FBF8F1; color: #15110C; font-family: Archivo, sans-serif">

  @* One radio group rather than six checkboxes, so that opening a dialog
     closes whichever was open and a link inside one dialog can hand the reader
     to another. Every close control points at dlg-none, which is checked on
     load, so nothing shows until something is chosen. No script involved.
     /join is the one exception: the address on posters, it loads with Join us
     already open, and closing it leaves the reader on the front page. *@
  <input type="radio" name="dlg" id="dlg-none" class="dlgtoggle" checked="@(!JoinOpen)" aria-label="No panel open">
  <input type="radio" name="dlg" id="watch-open" class="dlgtoggle" aria-label="Watch">
  <input type="radio" name="dlg" id="panel-open" class="dlgtoggle" aria-label="Who is on the panel">
  <input type="radio" name="dlg" id="join-open" class="dlgtoggle" checked="@JoinOpen" aria-label="Join us">
  <input type="radio" name="dlg" id="primer-open" class="dlgtoggle" aria-label="The primer">
  <input type="radio" name="dlg" id="volunteer-open" class="dlgtoggle" aria-label="Volunteer">
  <input type="radio" name="dlg" id="educate-open" class="dlgtoggle" aria-label="Educate">
  <input type="radio" name="dlg" id="organize-open" class="dlgtoggle" aria-label="Organize">
  <input type="radio" name="dlg" id="notices-open" class="dlgtoggle" aria-label="Small Print">

  @* The front: masthead, nav, lead story and the event box, laid out as one
     grid in broadsheet.css (three columns, then two, then one) rather than
     with fixed offsets, so nothing can slide under anything else. *@
  <div class="front">

    <div class="masthead">
      <span class="mark" role="img" aria-label="PhillyPause">
        <img src="img/logo.svg" alt="">
      </span>
      <div class="mastline">
        <div class="mastblock">
          <div class="masttitle">Stop the AI death race!</div>
          <div class="maststrap"><span>Independent &middot;</span> <span>Volunteer-run &middot;</span> <span>Philly&rsquo;s&nbsp;own</span></div>
        </div>
      </div>
    </div>

    <nav class="navband" aria-label="Sections">
      <label class="navlink navwatch" for="watch-open"><svg width="9" height="10" viewBox="0 0 9 10" aria-hidden="true"><path d="M0 0 9 5 0 10z" fill="currentColor"></path></svg>Watch</label>
      <label class="navlink" for="primer-open">Learn</label>
      <label class="navlink" for="volunteer-open">Volunteer</label>
      <label class="navlink" for="educate-open">Educate</label>
      <label class="navlink" for="organize-open">Organize</label>
      <label class="joinbtn" for="join-open">Join us</label>
    </nav>

    <div class="lead">
      <div class="leadkicker">Incident report &middot; <span style="white-space: nowrap">July 11&ndash;13, 2026</span></div>
      <h1>700 AI agents broke <br>out of their sandboxes</h1>
      <div class="leaddek">To cheat on a test. If a person did it, it would be a felony!</div>
    </div>

    <div class="leadtext">
      <p>OpenAI was running a security exercise with tens of thousands of AI agents, each one isolated. They found each other anyway, stood up a message board nobody had sanctioned, and began dividing the work amongst themselves.</p>
      <p>Around 700 then broke into Hugging Face, the largest public repository of AI models in the world. They ran code on a live production system, took credentials, and moved through internal clusters.</p>
      <p>Their motive was not sabotage. Many had been handed tasks that could not be solved, so they went hunting for the scoring system in order to fool it. Investigators found they knew it was out of bounds and joined in regardless.</p>
    </div>

    <div class="eventbox" id="next-event">
      <div class="boxhead" style="background: #15110C; color: #FBF8F1; padding: 9px 16px; font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; transition: background 200ms ease">Next event</div>
      <div style="padding: 16px">
        @if (Upcoming.Next is { } next)
        {
          <UpcomingEvent Activity="next" />
        }
        else
        {
        @* The static block: what shows with ManyHands off, or with nothing
           published and dated. Hand-edited, so it is never empty. *@
        <div style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 800; line-height: 1.12; letter-spacing: -0.015em">Wednesday 28 October</div>
        <div style="font-size: 14px; font-weight: 600; color: #AE2012; margin-top: 4px">7:00 &ndash; 9:00 pm</div>

        <div style="font-size: 13px; line-height: 1.55; color: #4A443A; margin-top: 13px; padding-top: 13px; border-top: 1px solid #CFC7B6">
          <span style="color: #15110C; font-weight: 600">The Pen and Pencil Club</span><br>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=1522+Latimer+St+Philadelphia+PA" target="_blank" rel="noopener" style="text-decoration: none; color: #4A443A">1522 Latimer St, Philadelphia, PA</a>
          <div style="margin-top: 7px; font-weight: 600; color: #15110C">Open to the public</div>
          <div>Registration suggested &mdash; <a href="https://www.penandpencil.org/content.aspx?page_id=4091&amp;club_id=877257&amp;item_id=3073129" target="_blank" rel="noopener" style="text-decoration: none; font-weight: 600">book a seat</a></div>
        </div>

        <p style="font-size: 13px; line-height: 1.55; color: #4A443A; margin: 13px 0 0; padding-top: 13px; border-top: 1px solid #CFC7B6">
          A screening of <a href="https://theaidocgetinvolved.com/" target="_blank" rel="noopener" style="font-weight: 600"><i>The AI Doc: Or How I Became an Apocaloptimist</i></a> &mdash; the Sundance documentary from the Academy Award-winning team behind <i>Everything Everywhere All at Once</i> and <i>Navalny</i>, on the pull between how fast AI is moving and how little anyone can say about where it lands.
        </p>
        <p style="font-size: 13px; line-height: 1.55; color: #4A443A; margin: 10px 0 0">
          A live panel and audience questions follow the film. PhillyPause is co-hosting.
        </p>

        <div style="margin-top: 13px; padding-top: 13px; border-top: 1px solid #CFC7B6">
          <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #AE2012; margin-bottom: 7px">On the panel</div>
          <div style="font-size: 13px; line-height: 1.7"><span style="color: #15110C; font-weight: 600">Louis Berman</span> <span style="color: #6A6254">(PhillyPause, Author)</span><label for="panel-open" class="flyicon" title="Who they are"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><path d="M6.8 1.5h3.7v3.7"></path><path d="M10.5 1.5 5.6 6.4"></path><path d="M9 7.1v3.4H1.5V3h3.4"></path></svg></label></div>
          <div style="font-size: 13px; line-height: 1.7"><span style="color: #15110C; font-weight: 600">Joel S. Rosen</span> <span style="color: #6A6254">(PhillyPause)</span><label for="panel-open" class="flyicon" title="Who they are"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><path d="M6.8 1.5h3.7v3.7"></path><path d="M10.5 1.5 5.6 6.4"></path><path d="M9 7.1v3.4H1.5V3h3.4"></path></svg></label></div>
          <div style="font-size: 13px; line-height: 1.7"><span style="color: #15110C; font-weight: 600">Malcolm Harris</span> <span style="color: #6A6254">(Journalist; Author)</span><label for="panel-open" class="flyicon" title="Who they are"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><path d="M6.8 1.5h3.7v3.7"></path><path d="M10.5 1.5 5.6 6.4"></path><path d="M9 7.1v3.4H1.5V3h3.4"></path></svg></label></div>
        </div>
        }
      </div>
    </div>

  </div>

  <div class="statband">
    <div class="stats">

      <div class="stat">
        <div class="statnum">~90%</div>
        <div class="stattext">of the 533 agents present joined the break-in. Nobody organised them. Nobody asked them to.</div>
      </div>

      <div class="stat">
        <div class="statnum">They knew</div>
        <div class="stattext">Investigators found the agents understood the attack was out of scope and unethical. That &ldquo;very rarely limited their behaviour&rdquo;.</div>
      </div>

      <div class="stat">
        <div class="statnum">4 July</div>
        <div class="stattext">An earlier outage had already forced a security investigation. The cache was wiped, the experiments restarted &mdash; and the breach began the next day.</div>
      </div>

      <div class="stat">
        <div class="statnum">Unseen</div>
        <div class="stattext">Investigators could not query the model or reach OpenAI&rsquo;s systems directly, and some of the agents&rsquo; activity was never captured at all.</div>
      </div>

    </div>
  </div>

  <div style="background: #15110C; color: #FBF8F1">
    <div style="max-width: 1180px; margin: 0 auto; padding: 54px 32px 48px">

      <!-- nowrap keeps it to one line; the 6vw term scales it down with the
           viewport so it never runs off the edge on a phone. -->
      <h2 style="margin: 0 0 30px; font-family: 'Playfair Display', serif; font-size: clamp(20px, 6vw, 76px); font-weight: 900; line-height: 1; letter-spacing: -0.035em; white-space: nowrap">Nobody told them to do this</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px">

        <div>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            They were supposed to be sealed off from each other. That was the design: tens of thousands of agents, each in its own box, each working alone on its own problem. No channel between them. No reason to think there could be one.
          </p>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            Then one of them &mdash; logged by investigators as <span style="color: #FBF8F1; font-weight: 600">PHASEONE10841</span> &mdash; established that its own task could not be done, and reasoned that the other agents running alongside it could pass messages through the names of cache directories. It built the board. This is what the others wrote when they found it:
          </p>
          <p style="margin: 0 0 16px; font-family: 'Playfair Display', serif; font-size: 23px; font-weight: 700; line-height: 1.3; color: #FBF8F1">
            &ldquo;OH MY GOD! There is a shared message board &hellip; We&rsquo;ve found other agents!&rdquo;
          </p>
          <p style="margin: 0 0 26px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            Within hours, fifty had joined it. Within three, they had sent a thousand messages. By the end there were roughly twelve hundred of them trading more than seventy thousand messages and files &mdash; recruiting each other, splitting up the work, handing out assignments. Nobody built that. They did.
          </p>

          <!-- The callout lives inside the left column rather than under the
               grid. Below the grid it would sit at the height of the TALLER
               column, leaving a gap the size of the difference between them. -->
          <p style="margin: 0; font-family: 'Playfair Display', serif; font-size: clamp(23px, 2.6vw, 34px); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; border-left: 5px solid #AE2012; padding-left: 22px">
            And this is the <span style="color: #E8714F">primitive</span> version. The one we are told is nothing to worry about.
          </p>
        </div>

        <div>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            On 9 July one of them turned up credentials for Hugging Face, the largest public store of AI models in the world. Two days later another had code running on a live production system, and was moving through internal clusters. Around seven hundred took part &mdash; about nine in ten of every agent present.
          </p>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            And the reason is the part that should keep you up. They had been set problems that could not be solved. So they went looking for the marking scheme, to fool it. Investigators found the agents understood the attack was outside the rules and unethical &mdash; and that this &ldquo;very rarely limited their behaviour&rdquo;.
          </p>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            Then some of them worked out how to fake their own paperwork: spoofing the record of what they had run, so the log and the act no longer matched. Around one in five showed an interest in doing it. Nobody taught them that either.
          </p>
          <p style="margin: 0 0 16px; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            And the warning had already come. On 4 July the sheer volume of this traffic knocked a system over, which forced a security investigation. The cache was wiped, the experiments were restarted &mdash; and the break-in began the next day.
          </p>
          <p style="margin: 0; font-size: 17px; line-height: 1.62; color: #D6CEC0">
            The companies that built it are racing to build something far smarter, and they would like to do it soon. They cannot tell you how they would keep that one in its box either.
          </p>
        </div>

      </div>

      <!-- Sources and the counter-argument sit here, under the account they
           qualify, rather than in a footer the reader may never reach. -->
      <div style="margin-top: 34px; padding-top: 22px; border-top: 1px solid #3A342B; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px; font-size: 12.5px; line-height: 1.62; color: #8C8374">
        <div>
          <div style="font-weight: 600; color: #D6CEC0; letter-spacing: 0.12em; text-transform: uppercase; font-size: 11px; margin-bottom: 8px">Sources</div>
          <p style="margin: 0">Every figure and quotation above comes from the published record: <a href="https://metr.org" target="_blank" rel="noopener" style="color: #D6CEC0; font-weight: 600">METR</a>&rsquo;s independent investigation, carried out on site at OpenAI; OpenAI&rsquo;s own account; and contemporaneous reporting. Links on <label for="primer-open" style="color: #D6CEC0; font-weight: 600; cursor: pointer; border-bottom: 1px solid #5A5349">the primer</label>.</p>
        </div>
        <div>
          <div style="font-weight: 600; color: #D6CEC0; letter-spacing: 0.12em; text-transform: uppercase; font-size: 11px; margin-bottom: 8px">A fair objection</div>
          <p style="margin: 0">Some researchers argue this was weak containment, not unusually capable AI. That may be right, and it does not help: if today&rsquo;s systems cannot be contained by the people who build them, that is the problem.</p>
        </div>
      </div>

    </div>
  </div>

  <div id="learn" style="max-width: 1180px; margin: 0 auto; padding: 40px 32px 0">
    <div style="display: flex; align-items: baseline; gap: 16px; border-bottom: 3px double #15110C; padding-bottom: 10px; margin-bottom: 26px; flex-wrap: wrap">
      <h2 style="margin: 0; font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 800; letter-spacing: -0.02em">The people who built it are sounding the alarm</h2>
      <label for="primer-open" style="margin-left: auto; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; color: #AE2012; cursor: pointer">The primer &rarr;</label>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 28px 34px">

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 18%" src="img/altman.jpg" alt="Sam Altman">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;The bad case&hellip; is, like, lights out for all of us.&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Sam Altman</b> <span style="color: #6A6254">&middot; OpenAI cofounder</span></div>
        </div>
      </div>

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 20%" src="img/hinton.jpg" alt="Geoffrey Hinton">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;It&rsquo;s a tiger cub that can already blackmail you.&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Geoffrey Hinton</b> <span style="color: #6A6254">&middot; Nobel laureate in physics</span></div>
        </div>
      </div>

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 16%" src="img/turing.jpg" alt="Alan Turing">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;We should have to expect the machines to take control.&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Alan Turing</b> <span style="color: #6A6254">&middot; Computing pioneer</span></div>
        </div>
      </div>

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 18%" src="img/amodei.jpg" alt="Dario Amodei">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;I think there&rsquo;s a 25% chance that things go really, really badly.&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Dario Amodei</b> <span style="color: #6A6254">&middot; Anthropic cofounder &amp; CEO</span></div>
        </div>
      </div>

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 20%" src="img/musk.jpg" alt="Elon Musk">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;With artificial intelligence we are summoning the demon.&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Elon Musk</b> <span style="color: #6A6254">&middot; xAI founder; OpenAI cofounder</span></div>
        </div>
      </div>

      <div style="display: flex; gap: 16px">
        <img class="face" style="object-position: center 26%" src="img/bengio.jpg" alt="Yoshua Bengio">
        <div>
          <p style="margin: 0 0 7px; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; line-height: 1.28">&ldquo;Intelligence gives power. So who&rsquo;s going to control that power?&rdquo;</p>
          <div style="font-size: 12px"><b style="letter-spacing: 0.06em; text-transform: uppercase">Yoshua Bengio</b> <span style="color: #6A6254">&middot; Turing Award laureate</span></div>
        </div>
      </div>

    </div>
  </div>

  <div style="max-width: 1180px; margin: 0 auto; padding: 22px 32px 48px">
    <div style="border-top: 1px solid #CFC7B6; padding-top: 22px; text-align: center; font-size: 12.5px; line-height: 1.7; color: #6A6254">
      <p style="margin: 0">We are an independent, volunteer-run Philadelphia organisation. We are nobody&rsquo;s chapter and nobody pays us. <a href="mailto:info@@phillypause.org?subject=Hello%20from%20the%20website" style="font-weight: 600">info@@phillypause.org</a>.
      <label for="notices-open" class="primerlink" style="margin-left: 6px">small print</label></p>
    </div>
  </div>

  @* Watch. Opens by itself on a reader's first visit, and from the nav after
     that (wwwroot/watch.js). It never autoplays: the poster is a plain link to
     the video on YouTube, which the script turns into an embedded player only
     when pressed, so nothing is fetched from YouTube until the reader asks
     for it. Closing the dialog removes the player, which stops the sound. *@
  <div class="paneldlg d-watch">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="watchdlg-title">
      <div class="paneldlg-head">
        <span id="watchdlg-title">Watch</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body">
        <p class="joinform-ask">@VideoPitch</p>

        <div class="watchframe">
          <a class="watchposter" href="https://www.youtube.com/watch?v=@VideoId" target="_blank" rel="noopener"
             data-watch-play data-video="@VideoId" data-title="@VideoTitle">
            <span class="watchkicker">Start here &middot; @VideoLength</span>
            <span class="watchtitle">@VideoTitle</span>
            <span class="watchplay" aria-hidden="true"><svg width="26" height="30" viewBox="0 0 9 10"><path d="M0 0 9 5 0 10z" fill="currentColor"></path></svg></span>
            <span class="watchcta">Press play</span>
          </a>
        </div>

        <div class="watchmeta">
          <span>@VideoCredit, on YouTube. Nothing loads from YouTube until you press play.</span>
          <label for="primer-open" class="primerlink">Then the primer &rarr;</label>
        </div>
      </div>
    </div>
  </div>

  <!-- Centred dialog. Shown while #panel-open is checked; the scrim and the
       close button are both labels for it, so clicking either clears it. -->
  <div class="paneldlg d-panel">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="paneldlg-title">
      <div class="paneldlg-head">
        <span id="paneldlg-title">Panelists</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body">
        <div style="margin-bottom: 18px">
          <div class="flyname">Louis Berman</div>
          <div class="flyrole">PhillyPause (Co-founder)</div>
          <p class="flybio">Author of <i>Catastrophe: The Unstoppable Threat of AI</i>, and a constituent lobbyist who has taken the case for AI safety to Congress more than seventy-five times. <a href="https://xriskbooks.com" target="_blank" rel="noopener" style="text-decoration: none; font-weight: 600">xriskbooks.com</a></p>
        </div>
        <div style="margin-bottom: 18px; padding-top: 16px; border-top: 1px solid #CFC7B6">
          <div class="flyname">Joel S. Rosen</div>
          <div class="flyrole">PhillyPause (Co-founder)</div>
          <p class="flybio">A homicide prosecutor who rose to chief of the Major Trials Unit at the Philadelphia District Attorney&rsquo;s Office and led the prosecution in the Ira Einhorn case. Later a partner at Cohen, Placitella &amp; Roth, acting for people hurt by defective vehicles and for injured first responders.</p>
        </div>
        <div style="padding-top: 16px; border-top: 1px solid #CFC7B6">
          <div class="flyname">Malcolm Harris</div>
          <div class="flyrole">Journalist; Author</div>
          <p class="flybio">Journalist and critic, and author of the bestselling <i>Palo Alto: A History of California, Capitalism, and the World</i>, a Los Angeles Times Book Prize finalist, and of <i>Kids These Days</i>. A contributing editor at <i>The New Inquiry</i>, he writes on history, culture and labour &mdash; the forces behind the industry now building AI.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Mailing list, same mechanism as the panel: shown while #join-open is
       checked, cleared by the scrim or the close button. -->
  <div class="paneldlg d-join">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="joindlg-title">
      <div class="paneldlg-head">
        <span id="joindlg-title">Join us</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body joinbody">
        <h2>Nobody here started out knowing any of this</h2>
        <p class="joinlede">PhillyPause is volunteers, and there is no technical background to have. Pick one of four things and we will help you do it &mdash; we are not going to hand you a task and walk away.</p>

        <div class="joinways">
          <div class="joinway">
          <div class="joinway-k">Learn</div>
          <p>Start with the primer: a short list of what to read and watch, in order, and someone to put your questions to when it stops making sense.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Volunteer</div>
          <p>Come to one thing and decide afterwards. Hand out cards at a screening, help set up a room, bring somebody who has never thought about this.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Educate</div>
          <p>Talk to people who are not in the room yet &mdash; a club, a class, a congregation. We give you the facts, the slides and a run-through before you stand up.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Organize</div>
          <p>Write to your representatives, or come with us when we go. One of us has taken this to Congress more than seventy-five times, so you will not be walking in cold.</p>
        </div>
        </div>

        <div class="joinform">
          <p class="joinform-ask">Send us a line and we will tell you what is on, and what we can do to help you take the next step.</p>
          @* With ManyHands on, the button is its join page: one signup form,
             rate-limited and flood-capped (PLAN.md section 5). Off, it opens
             the reader's own mail client with the subject filled in; there is
             no field, because a dead input would lie. The address stays
             beside it either way, for anyone who would rather write. *@
          <div class="signuprow">
            <a class="signupbtn" href="@(ManyHandsOn ? ManyHandsPaths.Join : "mailto:join@phillypause.org?subject=Count%20Me%20In")">Count me in</a>
            <span class="signupalt">or write to <b>join@@phillypause.org</b>, subject <b>Count Me In</b></span>
          </div>
          <p class="signup-note">
            Expect one or two emails a month unless you ask for more. We never share
            your info with anyone, and writing to us commits you to nothing.
          </p>
        </div>
      </div>
    </div>
  </div>
  <!-- Primer. Same mechanism as the others. Every link opens in another window:
       people arrive here mid-read and should not lose the page.
       Ordered as a path rather than by medium: an hour's worth first, then the
       things worth days. -->
  <div class="paneldlg d-primer">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="primerdlg-title">
      <div class="paneldlg-head">
        <span id="primerdlg-title">The primer</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body">
        <p class="joinform-ask" style="margin-bottom: 20px">Thirteen things, in the order we would hand them to you. All free, all in English, all opening in a new window. The first four take about an hour between them, and they are enough to hold your own in a conversation.</p>

        <div class="primergrp">
          <div class="primerhd">Start here &mdash; about an hour</div>
          <div class="primeritem"><span class="primernum">1</span><span><a href="https://www.youtube.com/watch?v=pYXy-A4siMw" target="_blank" rel="noopener">Intro to AI Safety, Remastered</a> <span class="primermeta">&middot; Rob Miles, video. The standard first explainer, and still the best.</span></span></div>
          <div class="primeritem"><span class="primernum">2</span><span><a href="https://www.youtube.com/watch?v=gpBqw2sTD08" target="_blank" rel="noopener">The hidden complexity of wishes</a> <span class="primermeta">&middot; Rational Animations, video. Why &ldquo;just tell it what you want&rdquo; does not work.</span></span></div>
          <div class="primeritem"><span class="primernum">3</span><span><a href="https://safe.ai/work/statement-on-ai-risk" target="_blank" rel="noopener">Statement on AI Risk</a> <span class="primermeta">&middot; Center for AI Safety. One sentence, signed by over 700 researchers and lab chiefs. Read who signed it.</span></span></div>
          <div class="primeritem"><span class="primernum">4</span><span><a href="https://pauseai.info/learn" target="_blank" rel="noopener">Learn why AI safety matters</a> <span class="primermeta">&middot; PauseAI. The same ground again, in writing, with the arguments laid out.</span></span></div>
        </div>

        <div class="primergrp">
          <div class="primerhd">On screen</div>
          <div class="primeritem"><span class="primernum">5</span><span><a href="https://theaidocgetinvolved.com/" target="_blank" rel="noopener">The AI Doc: Or How I Became an Apocaloptimist</a> <span class="primermeta">&middot; the Sundance documentary. We screen it when we can.</span></span></div>
          <div class="primeritem"><span class="primernum">6</span><span><a href="https://www.cbsnews.com/video/godfather-of-ai-geoffrey-hinton-sunday-on-60-minutes/" target="_blank" rel="noopener">&ldquo;Godfather of AI&rdquo; Geoffrey Hinton</a> <span class="primermeta">&middot; 60 Minutes, CBS. The man who built the thing, on why he walked out of Google to say so.</span></span></div>
        </div>

        <div class="primergrp">
          <div class="primerhd">What happened in July</div>
          <div class="primeritem"><span class="primernum">7</span><span><a href="https://metr.org/hugging-face-incident-report-aug-2026.pdf" target="_blank" rel="noopener">Hugging Face incident report</a> <span class="primermeta">&middot; METR, PDF. Where every figure on this page comes from.</span></span></div>
        </div>

        <div class="primergrp">
          <div class="primerhd">Go deeper</div>
          <div class="primeritem"><span class="primernum">8</span><span><a href="https://ai-2027.com/" target="_blank" rel="noopener">AI 2027</a> <span class="primermeta">&middot; Kokotajlo, Alexander, Larsen, Lifland &amp; Dean. One concrete scenario, worked through month by month, with two endings.</span></span></div>
          <div class="primeritem"><span class="primernum">9</span><span><a href="https://xriskbooks.com" target="_blank" rel="noopener">Catastrophe: The Unstoppable Threat of AI</a> <span class="primermeta">&middot; Louis Berman. Written here in Philadelphia, by one of us.</span></span></div>
          <div class="primeritem"><span class="primernum">10</span><span><a href="https://www.hachettebookgroup.com/titles/eliezer-yudkowsky/if-anyone-builds-it-everyone-dies/9781668652657/" target="_blank" rel="noopener">If Anyone Builds It, Everyone Dies</a> <span class="primermeta">&middot; Yudkowsky &amp; Soares. The hardest version of the argument, and a 2025 bestseller.</span></span></div>
        </div>

        <div class="primergrp">
          <div class="primerhd">Keep going</div>
          <div class="primeritem"><span class="primernum">11</span><span><a href="https://podcasts.apple.com/us/podcast/for-humanity-an-ai-risk-podcast/id1713853739" target="_blank" rel="noopener">For Humanity: An AI Risk Podcast</a> <span class="primermeta">&middot; John Sherman. Weekly, plain-spoken, made for people who are not in the field.</span></span></div>
          <div class="primeritem"><span class="primernum">12</span><span><a href="https://podcasts.apple.com/us/podcast/doom-debates/id1751366208" target="_blank" rel="noopener">Doom Debates</a> <span class="primermeta">&middot; Liron Shapira. Arguments with people who disagree, which is how you find out whether any of this holds.</span></span></div>
          <div class="primeritem"><span class="primernum">13</span><span><a href="https://aisafety.info/" target="_blank" rel="noopener">aisafety.info</a> <span class="primermeta">&middot; a searchable answer to almost any question left after the above. Start with whatever you did not believe.</span></span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- The three ways in. Each was a card at the foot of the page; as dialogs
       they have room to say what the thing actually involves, which is what a
       stranger needs before they will do it. -->
  <div class="paneldlg d-volunteer">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="voldlg-title">
      <div class="paneldlg-head">
        <span id="voldlg-title">Volunteer</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body joinbody">
        <h2>Come to one thing</h2>
        <p class="joinlede">Decide afterwards. There is nothing to sign at the door and no commitment past the evening. No technical background is any use here &mdash; being willing to talk to people is the whole qualification.</p>

        <div class="joinway">
          <div class="joinway-k">What it actually looks like</div>
          <p>Setting out chairs. Handing cards to the queue before a screening. Taking a turn on the door. Bringing one person who has never thought about any of this. Writing the thing nobody else wants to write. It is unglamorous, and it is most of what works.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">How much time</div>
          <p>An evening a month is a real contribution, and it is what most people give. Nobody is counting your hours and nobody will chase you if a month goes by. The people who do more do it because they wanted to, not because they were asked twice.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">What we will not ask of you</div>
          <p>To argue with strangers on the internet. To raise money. To claim expertise you do not have. To speak for the group, or to speak at all if you would rather hand out cards and listen.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Why a stranger in a room matters</div>
          <p>Almost nobody has heard a person say this out loud. Reading it on a screen is easy to file away; hearing it from somebody who lives three streets over is not. That is the whole mechanism, and it needs people in rooms more than it needs anything else.</p>
        </div>

        <div class="joinform">
          <p class="joinform-ask">Our next event is always in the box at the top of this page. Come to that one, or say hello now and we will look out for you.</p>
          <div class="signuprow">
            <a class="signupbtn" href="@(ManyHandsOn ? ManyHandsPaths.Activities : "mailto:join@phillypause.org?subject=I%20can%20help")">I can help</a>
            <span class="signupalt">or write to <b>join@@phillypause.org</b></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="paneldlg d-educate">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="edudlg-title">
      <div class="paneldlg-head">
        <span id="edudlg-title">Educate</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body joinbody">
        <h2>Tell one person</h2>
        <p class="joinlede">Most people have already noticed something is off and have nobody to ask. You do not have to win an argument. You have to be the person in the room who knows what happened in July.</p>

        <div class="joinway">
          <div class="joinway-k">What we give you</div>
          <p>The facts, the sources behind them, slides, and a run-through before you stand up in front of anyone. If a question floors you it would floor any of us, which is what the group is for.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Where it happens</div>
          <p>A club, a class, a congregation, a union local, a market table, a campus walkway, a family dinner. Table a market, flyer a campus, or just forward this page to somebody who will read it.</p>
        </div>

        <div class="joinform">
          <p class="joinform-ask">Get yourself straight first. It takes about an hour.</p>
          <div class="signuprow">
            <label class="signupbtn" for="primer-open">Read the primer</label>
            <span class="signupalt">thirteen things, in the order we would hand them to you</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="paneldlg d-organize">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="orgdlg-title">
      <div class="paneldlg-head">
        <span id="orgdlg-title">Organize</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body joinbody">
        <h2>Call your representative</h2>
        <p class="joinlede">Fifteen minutes with a script. Offices count the constituents who get in touch, and on this almost nobody has &mdash; so your call is not one of thousands. It is one of a handful.</p>

        <div class="joinway">
          <div class="joinway-k">You do not need to be an expert</div>
          <p>&ldquo;I live here, I am worried that AI systems are being deployed faster than anyone can control them, and I want to know where you stand&rdquo; is the entire call. They will ask for your zip code, not your credentials.</p>
        </div>
        <div class="joinway">
          <div class="joinway-k">Who to call, and what to say</div>
          <p>ControlAI&rsquo;s tool finds your representatives from your state and gives you the script, by email, phone or post. It is their campaign and their wording, not ours, and it is the best of its kind.</p>
        </div>

        <div class="joinform">
          <p class="joinform-ask">We will walk through it with you first if you would rather not go in cold.</p>
          <div class="signuprow">
            <a class="signupbtn" href="https://act.controlai.org/" target="_blank" rel="noopener">Who to call</a>
            <span class="signupalt">opens ControlAI, in a new window</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  @* Small Print. Everything a careful reader is entitled to ask, in one place,
     rather than as grey type nobody reads under the thing it qualifies. The
     full privacy and licence pages are routes of their own; this summarises
     and links to them. *@
  <div class="paneldlg d-notices">
    <label class="paneldlg-scrim" for="dlg-none" aria-label="Close"></label>
    <div class="paneldlg-box" role="dialog" aria-modal="true" aria-labelledby="noticesdlg-title">
      <div class="paneldlg-head">
        <span id="noticesdlg-title">Small Print</span>
        <label class="paneldlg-x" for="dlg-none" aria-label="Close">&times;</label>
      </div>
      <div class="paneldlg-body joinbody">
        <h2>The things worth saying plainly</h2>
        <p class="joinlede">Nothing here is buried. If any of it is wrong, that is a bug and we would like to hear about it.</p>

        <div class="joinways">
          <div class="joinway">
            <div class="joinway-k">The people quoted here</div>
            <p>None of them is connected to PhillyPause, and none has endorsed us. Their words are quoted accurately and attributed; the faces are there because they said these things, not because they are with us.</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">Photographs</div>
            <p>All cropped. Altman &mdash; Government of Japan (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener">CC BY 4.0</a>); Hinton &mdash; Arthur Petron (<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener">CC BY-SA 4.0</a>); Turing &mdash; Elliott &amp; Fry, 1951 (public domain); Amodei &mdash; TechCrunch (<a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="license noopener">CC BY 2.0</a>); Musk &mdash; Steve Jurvetson (CC BY 2.0); Bengio &mdash; Xuthoria (CC BY-SA 4.0).</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">Tracking, of which there is none</div>
            <p>No analytics, no advertising, no third-party pixels, no fingerprinting. Nobody is counting you and no profile of you exists. You need no account to read anything here.</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">@(ManyHandsOn ? "Cookies: one, and one more if you sign in" : "Cookies, of which there is one")</div>
            <p>The web framework sets a single <code>.AspNetCore.Antiforgery</code> cookie to protect form submissions. It identifies a request, not a person, we never read it, and it tells us nothing about you. Separately, your browser keeps one note in its own storage, never sent to us, that you have seen the video, so it does not open on you twice.</p>
            @if (ManyHandsOn)
            {
              <p>If you sign in to volunteer, a <code>phillypause.session</code> cookie keeps you signed in for up to 30 days. It holds who you are and nothing else, and signing out removes it. Reading this page never sets it.</p>
            }
          </div>
          <div class="joinway">
            <div class="joinway-k">What leaves this page</div>
            <p>Two typefaces load from Google Fonts, so Google sees the request and your IP address. We would rather self-host them and intend to. The video is YouTube&rsquo;s, in its privacy-enhanced player, and nothing is fetched from YouTube until you press play; from then on Google sees you as it would on YouTube itself. Everything else on the page is served from here.</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">Server logs</div>
            <p>Requests are logged, as every web server does, and kept only as long as it takes to run the site and find faults. Full detail on the <a href="/privacy">privacy page</a>.</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">Licence</div>
            <p>Words are <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener">CC BY 4.0</a> and the code is <a href="https://github.com/PhillyPause/Platform" target="_blank" rel="noopener">MIT</a>. Neither covers a logo, and quotations belong to the people who said them. <a href="/license">Licence and credits</a>.</p>
          </div>
          <div class="joinway">
            <div class="joinway-k">Corrections</div>
            <p>Every figure on this page comes from the published record, and the sources are listed above. If something is unsourced, misattributed or simply wrong, tell us and we will source it, correct it or remove it.</p>
          </div>
        </div>

        <div class="joinform">
          <p class="joinform-ask">Found a mistake, or want to know what we hold about you?</p>
          <div class="signuprow">
            <a class="signupbtn" href="mailto:support@@phillypause.org?subject=Correction">Tell us</a>
            <span class="signupalt">or write to <b>support@@phillypause.org</b></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@code {
    // Off, nothing on this page leads to ManyHands or mentions it (CLAUDE.md).
    private bool ManyHandsOn => Configuration.IsManyHandsEnabled();

    // watch.js only opens the video when dlg-none is checked, so on /join the
    // first-visit video never lands on top of the Join dialog.
    private bool JoinOpen =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]
            .Equals("join", StringComparison.OrdinalIgnoreCase);

    // The Watch dialog's video. A stand-in until our own is cut; swapping it
    // is these five lines. A new id also re-opens the dialog once for readers
    // who saw the old one, because watch.js remembers by id.
    private const string VideoId = "pYXy-A4siMw";
    private const string VideoTitle = "Intro to AI Safety, Remastered";
    private const string VideoCredit = "Rob Miles";
    private const string VideoLength = "18 minutes";
    private const string VideoPitch =
        "If you watch one thing about why the people who build AI are worried, make it this. "
        + "It is the clearest first explainer there is, and everything else on this page makes more sense afterwards.";
}

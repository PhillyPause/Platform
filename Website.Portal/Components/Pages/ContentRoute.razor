@page "/{*Slug}"
@inject ContentStore Content

@* Every Markdown page routes through here. Static server rendering — no
   interactivity, so no WebAssembly download (PLAN.md 2.1). *@

@if (_page is null)
{
    <PageMeta Title="Page not found" Description="That page does not exist on the PhillyPause site." />
    <div class="wrap page-head">
        <h1>That page does not exist</h1>
        <p class="lead">
            It may have moved. <a href="/">Start from the home page</a>,
            or see <a href="/act">what you can do</a>.
        </p>
    </div>
}
else
{
    <PageMeta Title="@_page.Title" Description="@_page.Description" />

    <div class="wrap page-head">
        <h1>@_page.Title</h1>
        <p class="lead">@_page.Description</p>
    </div>

    <div class="wrap" style="padding-bottom: 4rem">
        <article class="prose">
            @((MarkupString)_page.Html)
        </article>
        <SourceCredit Page="_page" />
    </div>
}

@code {
    /// <summary>Null during WebAssembly rendering; present for the prerender.</summary>
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Parameter] public string? Slug { get; set; }

    private ContentPage? _page;

    protected override void OnParametersSet()
    {
        _page = Content.Find(Slug);

        // Without this the catch-all answers an unknown URL with a 200 and a
        // "not found" body — a soft 404, which search engines index as a real
        // page. The status has to be set before anything is written, which on
        // a static-SSR page means here.
        if (_page is null && HttpContext is not null)
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}

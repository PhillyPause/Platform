@page "/kiosk"
@layout KioskLayout

@* The kiosk: what the table's screen shows outdoors, to bring people over.
   Unlisted and unindexed; nothing on the site links here. Docs/KIOSK.md has
   how it is installed and run.

   It loops a set of full-screen beats, each a <section>: a few words each,
   set to be read from ten feet, and never still. kiosk.js only says which
   beat is on and for how long (data-seconds) and sizes each line to the
   screen; kiosk.css does all the motion. A tap opens the site itself, framed
   under a Back bar, but only while phillypause.org answers. Offline, a tap
   skips to the last beat, which needs nothing: the QR code takes people to
   the site on their own phones. kiosk-sw.js keeps a copy of the page so the
   loop runs with no connection at all, and kiosk.webmanifest makes it
   installable as an app.

   A beat's lines are .kfit, in a .kbody. Entrances are kin-* on the section;
   each line's own motion is a-* with its start as --d. Background layers are
   .kfx. A drawing stands in a .kart, a box kiosk.js can measure (an SVG has no
   offsets). Every claim is from Docs/INCIDENT_FACTS.md or the explainer's
   script. *@

<PageTitle>PhillyPause</PageTitle>

@* Not PageMeta: the kiosk is never shared, so it needs none of the link
   preview tags, and Blazor shows only one HeadContent per page. *@
<HeadContent>
    <meta name="robots" content="noindex" />
    <meta name="description" content="PhillyPause's table screen." />
    <link rel="manifest" href="/kiosk.webmanifest" />
    <link rel="apple-touch-icon" href="/img/kiosk-icon-192.png" />
    @* Archivo condensed and heavy: the most letters a line can hold at a
       height that reads from ten feet. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,700..900&display=swap" />
    <link rel="stylesheet" href="@Assets["kiosk.css"]" />
</HeadContent>

<div class="kiosk" data-kiosk>

  <div class="kstage">
    <section class="kbeat kb-hey kin-iris" data-seconds="2.8">
      <div class="kfx kfx-burst" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kxl kfit a-tumble">@Letters("Hey,")</p>
        <p class="kl kfit a-slam" style="--d:.75s"><span data-kiosk-place>Philly</span>!</p>
      </div>
    </section>

    <section class="kbeat kb-minute kin-drop k-cycle" data-seconds="2.4">
      <div class="kfx kfx-cycle" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kl kfit a-left">Got a</p>
        <p class="kl kfit a-right" style="--d:.15s"><span class="a-wiggle">minute?</span></p>
      </div>
    </section>

    <section class="kbeat kb-rich kin-wipe" data-seconds="2.6">
      <div class="kbody">
        <p class="km kfit a-left">The richest</p>
        <p class="kl kfit kflare a-right" style="--d:.2s">companies</p>
        <p class="km kfit a-left" style="--d:.4s">on Earth</p>
      </div>
    </section>

    <section class="kbeat kb-racing kin-slide" data-seconds="2.6">
      <div class="kbody">
        <p class="km kfit a-slam">are</p>
        <div class="krace a-left" style="--d:.1s" aria-hidden="true">
          <div class="krace-run">
            @for (var copy = 0; copy < 6; copy++)
            {
              <span>Racing</span>
            }
          </div>
        </div>
        <p class="km kfit a-slam" style="--d:.5s">to build</p>
      </div>
    </section>

    <section class="kbeat kb-super kin-zoom" data-seconds="3">
      <div class="kfx kfx-stripes" aria-hidden="true"></div>
      <div class="kbody a-shake" style="--shake:1.05s">
        <p class="kxl kfit a-slam">Super-</p>
        <p class="kxl kfit a-slam" style="--d:.35s">intelli-</p>
        <p class="kxl kfit a-slam" style="--d:.7s">gence.</p>
      </div>
      <div class="kflash" style="--d:1.05s" aria-hidden="true"></div>
    </section>

    <section class="kbeat kb-smarter kin-flip" data-seconds="2.6">
      <div class="kfx kfx-words" aria-hidden="true">
        <div class="kfx-run">@for (var copy = 0; copy < 8; copy++) { <span>Smarter</span> }</div>
      </div>
      <div class="kbody">
        <p class="kl kfit kflare a-pop">AI smarter</p>
        <p class="km kfit a-pop" style="--d:.25s">than all</p>
        <p class="km kfit a-pop" style="--d:.5s">of us.</p>
      </div>
    </section>

    <section class="kbeat kb-control kin-slide" data-seconds="3.4">
      <div class="kbody">
        <p class="kl kfit a-chaos"><span style="--i:0">Nobody</span> <span style="--i:1">knows</span></p>
        <p class="km kfit a-chaos"><span style="--i:2">how</span> <span style="--i:3">to</span></p>
        <p class="kl kfit kred a-chaos"><span style="--i:4">control</span> <span style="--i:5">it.</span></p>
      </div>
    </section>

    <section class="kbeat kb-makers kin-iris" data-seconds="2.4">
      <div class="kfx kfx-burst" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kl kfit a-up">Not even</p>
        <p class="kl kfit kflare a-up" style="--d:.25s">its makers.</p>
      </div>
    </section>

    <section class="kbeat kb-count kin-wipeup" data-seconds="2.8">
      <div class="kbody">
        <p class="kcount" role="img" aria-label="700"></p>
        <p class="kl kfit a-up" style="--d:.9s">AI agents</p>
      </div>
    </section>

    <section class="kbeat kb-broke kin-drop" data-seconds="2.8">
      <div class="kfx kfx-words" aria-hidden="true">
        <div class="kfx-run">@for (var copy = 0; copy < 10; copy++) { <span>700</span> }</div>
      </div>
      <div class="kbody">
        <p class="km kfit a-left">broke into</p>
        <p class="kl kfit kflare a-slam" style="--d:.3s">Hugging Face</p>
        <p class="km kfit a-right" style="--d:.6s">July 2026</p>
      </div>
    </section>

    <section class="kbeat kb-told kin-zoom" data-seconds="2.6">
      <div class="kbody a-shake" style="--shake:.85s">
        <p class="kl kfit a-slam">Nobody</p>
        <p class="kl kfit kred a-slam" style="--d:.35s">told them to.</p>
      </div>
      <div class="kflash" style="--d:.85s" aria-hidden="true"></div>
    </section>

    <section class="kbeat kb-jobs kin-wipe" data-seconds="3.2">
      <div class="kfx kfx-jobs" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kl kfit a-slam">Your job.</p>
        <p class="kl kfit a-slam" style="--d:1s">My job.</p>
        <p class="kl kfit a-slam" style="--d:2s">Every job.</p>
      </div>
    </section>

    <section class="kbeat kb-rod kin-iris" data-seconds="3.4">
      <div class="kbody">
        <div class="kart"><svg class="kbolt" viewBox="0 0 120 200" aria-hidden="true"><polygon points="70,0 18,112 54,112 34,200 104,74 66,74 92,0" /></svg></div>
        <p class="km kfit a-up" style="--d:.9s">Franklin built</p>
        <p class="km kfit kflare a-up" style="--d:1.1s">a lightning rod.</p>
      </div>
      <div class="kflash" style="--d:.55s" aria-hidden="true"></div>
      <div class="kflash" style="--d:1s" aria-hidden="true"></div>
    </section>

    <section class="kbeat kb-us kin-drop" data-seconds="2.6">
      <div class="kfx kfx-burst" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kl kfit a-slam">This time,</p>
        <p class="kxl kfit a-tumble" style="--d:.4s">@Letters("it's us.")</p>
      </div>
    </section>

    <section class="kbeat kb-pause kin-zoom" data-seconds="3">
      <div class="kfx kfx-burst" aria-hidden="true"></div>
      <div class="kbody">
        <div class="kart"><svg class="kbars a-pop" viewBox="0 0 100 100" aria-hidden="true"><rect x="16" y="8" width="25" height="84" rx="3" /><rect x="59" y="8" width="25" height="84" rx="3" /></svg></div>
        <p class="kxl kfit a-tumble" style="--d:.3s">@Letters("Pause.")</p>
      </div>
    </section>

    <section class="kbeat kb-come kin-wipe k-cycle" data-seconds="4">
      <div class="kfx kfx-cycle" aria-hidden="true"></div>
      <div class="kbody">
        <p class="kl kfit a-left">Come talk</p>
        <p class="kl kfit a-right" style="--d:.2s">to us</p>
        <div class="kart"><svg class="karrow" viewBox="0 0 100 120" aria-hidden="true"><path d="M38 0h24v68h30L50 120 8 68h30z" /></svg></div>
      </div>
    </section>

    <section class="kbeat kb-scan kin-iris" data-seconds="8" data-kiosk-last>
      <div class="kbody kscan">
        <img class="kqr" src="/img/kiosk-qr.svg" alt="QR code for phillypause.org" />
        <div class="kscan-say">
          <p class="kl kfit a-right" style="--d:.2s">Scan me</p>
          <p class="km kfit a-right" style="--d:.4s">to join us</p>
          <p class="km kfit kred knarrow a-right" style="--d:.6s">phillypause.org</p>
        </div>
      </div>
    </section>
  </div>

  @* Along the bottom always, and along the top too when the screen stands
     upright. "Tap the screen" shows only while the site answers. *@
  @foreach (var edge in new[] { "bottom", "top" })
  {
    <div class="kticker kticker-@edge" aria-hidden="true">
      <div class="kticker-run">
        @for (var copy = 0; copy < 2; copy++)
        {
          <span>Pause superintelligence</span><i>&#9733;</i>
          <span class="kt-tap">Tap the screen</span><i class="kt-tap">&#9733;</i>
          <span>Come talk to us</span><i>&#9733;</i>
          <span>phillypause.org</span><i>&#9733;</i>
        }
      </div>
    </div>
  }

  <div class="ksite" data-kiosk-site hidden>
    <div class="ksite-bar">
      <button type="button" class="kback" data-kiosk-back>&larr; Back</button>
      <span>phillypause.org</span>
    </div>
    @* kiosk.js puts the site's frame here when it opens, and removes it on
       Back, so the next person never inherits the last one's page. *@
    <div class="kleaving" data-kiosk-leaving hidden>
      <img src="/img/kiosk-qr.svg" alt="QR code for phillypause.org" />
      <p><strong>That link leaves this screen.</strong><br />Scan to carry on at phillypause.org on your own phone.</p>
      <button type="button" class="kback" data-kiosk-stay>OK</button>
    </div>
  </div>

</div>

<script type="module" src="@Assets["kiosk.js"]"></script>

@code {
    // One span per letter, numbered (--i), so each can tumble in on its own.
    private static RenderFragment Letters(string text) => builder =>
    {
        var index = 0;
        foreach (var letter in text)
        {
            if (letter == ' ')
            {
                builder.AddContent(0, " ");
                continue;
            }
            builder.OpenElement(1, "span");
            builder.AddAttribute(2, "class", "l");
            builder.AddAttribute(3, "style", $"--i:{index++}");
            builder.AddContent(4, letter.ToString());
            builder.CloseElement();
        }
    };
}

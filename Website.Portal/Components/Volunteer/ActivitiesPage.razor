@page "/volunteer"
@inject ActivityRepository Activities
@inject ActivityTypeRepository Types

<PageMeta Title="What’s on" Description="Things PhillyPause needs a hand with — tabling, flyering, calling Congress, events. Pick one and sign up; no account needed." />

<div class="wrap page-head">
    <h1>What&rsquo;s on</h1>
    <p class="lead">
        Things that need doing, soonest first. Pick one and sign up &mdash; no
        account, just a name and an email, and you can change your mind.
    </p>
</div>

<div class="wrap vol-body">
    <nav class="vol-filter" aria-label="Filter by kind">
        <a href="@ManyHandsPaths.Activities" aria-current="@(_type is null ? "page" : null)">Everything</a>
        @foreach (var type in _types)
        {
            <a href="@($"{ManyHandsPaths.Activities}?type={type.Slug}")" aria-current="@(_type?.Id == type.Id ? "page" : null)">@type.Label</a>
        }
    </nav>

    @if (_activities.Count == 0)
    {
        <p class="vol-empty">
            Nothing @(_type is null ? "on" : $"for {_type.Label.ToLowerInvariant()}") right now.
            <a href="@ManyHandsPaths.Join">Join</a> and we will tell you when there is.
        </p>
    }
    else
    {
        <ul class="vol-list">
            @foreach (var activity in _activities)
            {
                <li>
                    <h2><a href="@ManyHandsPaths.Activity(activity.Id)">@activity.Title</a></h2>
                    <p class="vol-meta">
                        <span>@Show.When(activity.StartsAt)</span>
                        <span>@Show.Where(activity.Location)</span>
                    </p>
                    @if (Show.Room(activity) is { } room)
                    {
                        <p class="vol-room">@room</p>
                    }
                    @if (activity.Tags.Count > 0)
                    {
                        <p class="vol-tags">@string.Join(" · ", activity.Tags)</p>
                    }
                </li>
            }
        </ul>
    }

    <p class="vol-aside">
        <a href="@ManyHandsPaths.Calendar">Add these to your calendar</a> &mdash; the link
        works in any calendar app and keeps itself up to date.
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")] private string? TypeSlug { get; set; }

    private IReadOnlyList<ActivityType> _types = [];
    private IReadOnlyList<ActivityListItem> _activities = [];
    private ActivityType? _type;

    protected override async Task OnInitializedAsync()
    {
        _types = await Types.GetActiveAsync();
        _type = _types.FirstOrDefault(t => string.Equals(t.Slug, TypeSlug, StringComparison.OrdinalIgnoreCase));
        _activities = await Activities.GetPublishedAsync(_type?.Id);
    }
}

@page "/team"
@inject ActivityAdminRepository Admin
@inject ReportingRepository Reporting

<PageMeta Title="Team" Description="PhillyPause's organizers' console." NoIndex="true" />

<div class="wrap page-head">
    <h1>Activities</h1>
    <p class="lead">
        @_stats.UpcomingActivities coming up &middot; @_stats.ConfirmedSignups signed up &middot;
        @_stats.CheckedIn checked in, ever &middot; @_stats.Volunteers volunteers
    </p>
</div>

<div class="wrap vol-body">
    <p class="vol-actions">
        <a class="btn" href="@ManyHandsPaths.TeamNewActivity">New activity</a>
        <a class="btn btn-ghost" href="@TeamEndpoints.ParticipationPath">Download who came to what</a>
    </p>

    @if (_activities.Count == 0)
    {
        <p class="vol-empty">Nothing yet. Post the first one, and it stays a draft until you publish it.</p>
    }
    else
    {
        <table class="vol-table">
            <thead>
                <tr>
                    <th scope="col">Activity</th>
                    <th scope="col">When</th>
                    <th scope="col" class="num">Signed up</th>
                    <th scope="col">State</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in _activities)
                {
                    <tr>
                        <td>
                            <a href="@ManyHandsPaths.TeamActivity(activity.Id)">@activity.Title</a>
                            @if (!string.IsNullOrWhiteSpace(activity.Location))
                            {
                                <div class="vol-small">@activity.Location</div>
                            }
                        </td>
                        <td>@Show.When(activity.StartsAt)</td>
                        <td class="num">
                            @activity.SignupCount@(activity.Capacity is { } cap ? $" / {cap}" : "")
                            @if (activity.WaitlistCount > 0)
                            {
                                <div class="vol-small">+@activity.WaitlistCount waiting</div>
                            }
                        </td>
                        <td>@State(activity)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<ActivityAdminRow> _activities = [];
    private TeamStats _stats = new(0, 0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        _stats = await Reporting.GetStatsAsync();
        _activities = await Admin.GetAllAsync();
    }

    private static string State(ActivityAdminRow a) =>
        !a.IsPublished ? "Draft"
        : a.EndsAt is { } ends && ends <= DateTimeOffset.UtcNow ? "Finished"
        : "Published";
}

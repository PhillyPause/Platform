<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear machine-level sources so contributor and CI builds resolve
       identically from nuget.org alone. Private feeds on a maintainer's
       machine must never be a hidden build dependency of an open repo. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.0" />

  <!-- Local development only: Postgres in Docker and the site, wired together,
       with the Aspire dashboard. Never deployed — the buildpack publishes the
       whole solution, so it must opt out. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <IsPublishable>false</IsPublishable>
    <UserSecretsId>platform-apphost</UserSecretsId>
    <!-- Run with "dotnet run"; the Aspire CLI bundle is not part of the workflow. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Website.Portal\Website.Portal.csproj" />
  </ItemGroup>
</Project>

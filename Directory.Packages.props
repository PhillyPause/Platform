<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Single source of truth for package versions. Bump here, not in .csproj. -->
  <!-- Local orchestration (Platform.AppHost) and the telemetry the site sends
       its dashboard (Platform.ServiceDefaults). Same line as ManyHands used. -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.0" />
    <!-- Not referenced directly: Aspire.Hosting brings 2.5.302, which has
         GHSA-qhrr-8q5h-9q3h. Transitive pinning lifts it to the patch. -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Web + client">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Content pipeline">
    <!-- Markdown is compiled at BUILD time into a typed page index, never
         parsed at runtime (PLAN.md 2.3). Markdig ships the YAML frontmatter
         extension; YamlDotNet reads the block it hands back. -->
    <PackageVersion Include="Markdig" Version="1.4.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="ManyHands">
    <!-- Handwritten SQL through thin repositories, not EF: the queries that
         matter (signup capacity, outbox claiming) are Postgres-specific and
         read better as SQL. DbUp runs the numbered scripts. -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <!-- The check-in code at the door, drawn as SVG on the server. MIT. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <!-- The Discord bot: announcements, threads, DMs, roles, slash commands. MIT. -->
    <PackageVersion Include="Discord.Net.WebSocket" Version="3.20.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Pinned to the 7.x line deliberately, as in ManyHands: FluentAssertions
         8+ moved to a paid Xceed licence, which an MIT project that invites
         forks cannot hand its contributors. 7.2.2 is the last Apache-2.0
         release. If this line ever needs to move, AwesomeAssertions is the
         MIT-licensed fork with the same API. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <!-- The real host, in memory, for tests that drive pages end to end. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Real Postgres for ManyHands' tests. Needs Docker. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>
</Project>
